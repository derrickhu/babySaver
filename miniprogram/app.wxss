page {
  background: #f3f0e8;
  color: #241e18;
  font-size: 28rpx;
  font-family: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
}

.page.sub {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.menu-item {
  background: #fffdf8;
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 28rpx rgba(48, 36, 18, 0.05);
}

.menu-item.pressed { opacity: 0.72; }

.menu-index {
  width: 64rpx;
  font-family: "DIN Alternate", "Avenir Next Condensed", "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f4b99;
  flex: none;
}

.menu-copy { flex: 1; min-width: 0; }

.menu-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #241e18;
}

.menu-desc {
  margin-top: 6rpx;
  color: #8c8276;
  font-size: 24rpx;
}

.menu-arrow {
  color: #a3988c;
  font-size: 36rpx;
  margin-left: 12rpx;
}

.more-lead { margin: 8rpx 8rpx 22rpx; }
.more-kicker {
  color: #1f4b99;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}
.more-title {
  margin-top: 4rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #241e18;
}

.btn {
  margin: 0;
  background: #1f4b99;
  color: #fffdf8;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 2.2;
}

.btn::after {
  border: none;
}

.btn.ghost {
  background: #efeae2;
  color: #1f4b99;
}

.btn.warn {
  background: #fde8ec;
  color: #e11d48;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 8rpx 0 20rpx;
}

.btn-row .btn {
  width: auto;
  padding: 0 20rpx;
}

.field {
  background: #fffdf8;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(48, 36, 18, 0.04);
}

.field-label {
  color: #8c8276;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.field input {
  font-size: 30rpx;
}

.hint {
  color: #8c8276;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.search {
  display: flex;
  align-items: center;
  background: #fffdf8;
  border-radius: 20rpx;
  padding: 8rpx 8rpx 8rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(48, 36, 18, 0.04);
}

.search input { flex: 1; }

.search-btn {
  color: #1f4b99;
  font-weight: 650;
  padding: 12rpx 16rpx;
}

.dates, .segs, .names { white-space: nowrap; margin-bottom: 12rpx; }

.date-chip, .seg, .chip {
  display: inline-block;
  margin-right: 12rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #fffdf8;
  color: #6f675e;
  font-size: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(48, 36, 18, 0.04);
}

.seg.on, .chip.on {
  background: #1f4b99;
  color: #fffdf8;
  font-weight: 650;
}

.count {
  color: #8c8276;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.event {
  background: #fffdf8;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(48, 36, 18, 0.04);
}

.event .name { font-weight: 700; color: #241e18; }
.event .meta { margin-top: 6rpx; color: #8c8276; font-size: 22rpx; }
.event .params {
  margin-top: 8rpx;
  color: #6f675e;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}

.refresh-inline {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  color: #8c8276;
  font-size: 22rpx;
}

.banner {
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fde8ec;
  color: #e11d48;
  font-size: 24rpx;
  line-height: 1.5;
}

.skel-note, .state {
  text-align: center;
  color: #8c8276;
  padding: 40rpx 0;
}
