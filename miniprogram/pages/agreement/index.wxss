.agreement-page {
  padding: 32rpx;
  background: #fff;
  min-height: 100vh;
}

.agreement-header {
  margin-bottom: 48rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.agreement-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.agreement-version {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.agreement-content {
  height: calc(100vh - 240rpx);
}

.agreement-section {
  margin-bottom: 48rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #4a7cf7;
}

.section-text {
  display: block;
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.agreement-footer {
  margin-top: 64rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #f0f0f0;
  text-align: center;
}

.footer-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.footer-contact {
  display: block;
  font-size: 28rpx;
  color: #4a7cf7;
  margin-bottom: 12rpx;
}

.footer-update {
  display: block;
  font-size: 26rpx;
  color: #999;
}