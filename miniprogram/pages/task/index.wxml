<!-- 任务中心 -->
<view class="page-container">
  <!-- Tab 栏 -->
  <view class="tab-bar">
    <view
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >{{item.label}}</view>
  </view>

  <!-- 任务列表 -->
  <view class="task-list">
    <view
      class="task-card"
      wx:for="{{tasks}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onTaskTap"
    >
      <view class="task-top">
        <view class="task-title-row">
          <text class="task-title">{{item.title}}</text>
          <view class="task-title-right">
            <text class="task-status status-{{item.statusClass}}">{{item.statusText}}</text>
            <view class="task-more-btn" wx:if="{{item.isMyTask}}" catchtap="onMoreTap" data-id="{{item._id}}" data-status="{{item.status}}">
              <text class="more-icon">⋯</text>
            </view>
          </view>
        </view>
        <text class="task-desc" wx:if="{{item.description}}">{{item.description}}</text>
      </view>
      <view class="task-bottom">
        <view class="task-reward">
          <text class="reward-icon">💰</text>
          <text class="reward-amount">¥{{item.rewardStr}}</text>
        </view>
        <text class="task-deadline {{item.urgent ? 'urgent' : ''}}">{{item.deadlineText}}</text>
      </view>
      <!-- 认领者信息 -->
      <view class="task-claimer" wx:if="{{item.claimerName}}">
        <text class="claimer-label">🧒 {{item.claimerName}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && tasks.length === 0}}">
    <text class="empty-icon">{{activeTab === 'open' ? '📋' : (activeTab === 'active' ? '🏃' : '🏆')}}</text>
    <text class="empty-text">{{activeTab === 'open' ? '暂无待领取任务' : (activeTab === 'active' ? '暂无进行中任务' : '暂无已完成任务')}}</text>
    <button class="btn-create-empty" wx:if="{{canTaskPublish && activeTab === 'open'}}" bindtap="onCreateTask">发布新任务</button>
  </view>

  <!-- 加载 -->
  <view class="load-more" wx:if="{{loading && tasks.length > 0}}">
    <text>加载中...</text>
  </view>
  <view class="loading-wrap" wx:if="{{loading && tasks.length === 0}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 有权限的家长：发布任务按钮 -->
  <view class="fab-btn" wx:if="{{canTaskPublish}}" bindtap="onCreateTask">
    <text class="fab-icon">+</text>
  </view>
</view>
