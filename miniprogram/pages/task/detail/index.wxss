/* 任务详情 */
.page-container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 180rpx;
}

/* 状态横幅 */
.status-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  gap: 12rpx;
}
.banner-icon {
  font-size: 36rpx;
}
.banner-text {
  font-size: 28rpx;
  font-weight: 600;
}
.banner-open {
  background: #e8f0fe;
  color: #4a7cf7;
}
.banner-claimed {
  background: #fff3e0;
  color: #ff9800;
}
.banner-submitted {
  background: #f3e5f5;
  color: #9c27b0;
}
.banner-approved {
  background: #e8f5e9;
  color: #07c160;
}
.banner-rejected {
  background: #fbe9e7;
  color: #ff4d4f;
}
.banner-expired {
  background: #f5f5f5;
  color: #999;
}

/* 奖金卡片 */
.reward-card {
  margin: 24rpx;
  background: linear-gradient(135deg, #FFB800, #FF8C00);
  border-radius: 20rpx;
  padding: 36rpx;
  text-align: center;
  color: #fff;
}
.reward-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}
.reward-value {
  font-size: 64rpx;
  font-weight: 700;
  font-family: 'DIN', 'Helvetica Neue', sans-serif;
}

/* 信息卡片 */
.info-card {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}
.info-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}
.info-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}
.info-key {
  font-size: 26rpx;
  color: #999;
}
.info-val {
  font-size: 26rpx;
  color: #333;
}
.val-urgent {
  color: #ff4d4f;
  font-weight: 500;
}

/* 发布者操作区 */
.creator-actions {
  display: flex;
  gap: 20rpx;
  margin: 24rpx;
}
.btn-creator {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none !important;
}
.btn-edit {
  background: #e8f0fe !important;
  color: #4a7cf7 !important;
}
.btn-delete {
  background: #fff1f0 !important;
  color: #ff4d4f !important;
}
.btn-creator[disabled] { opacity: 0.5; }

/* 操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.action-bar-double {
  display: flex;
  gap: 20rpx;
}
.btn-action {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none !important;
}
.btn-primary {
  background: linear-gradient(135deg, #4a7cf7, #6c5ce7) !important;
  color: #fff !important;
}
.btn-approve {
  background: #07c160 !important;
  color: #fff !important;
}
.btn-reject {
  background: #fff1f0 !important;
  color: #ff4d4f !important;
}
.btn-action[disabled] { opacity: 0.5; }

/* 加载 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 300rpx;
}
.loading-text { font-size: 26rpx; color: #999; }
