/* 任务中心 */
.page-container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 140rpx;
}

/* Tab */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 12rpx 24rpx;
  gap: 12rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.2s;
}
.tab-item.active {
  background: #4a7cf7;
  color: #fff;
  font-weight: 600;
}

/* 任务列表 */
.task-list {
  padding: 16rpx 24rpx;
}
.task-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  transition: transform 0.15s;
}
.task-card:active {
  transform: scale(0.98);
}
.task-top {
  margin-bottom: 20rpx;
}
.task-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}
.task-desc {
  font-size: 24rpx;
  color: #999;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 状态标签 */
.task-status {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-weight: 500;
}
.status-open {
  background: rgba(74, 124, 247, 0.1);
  color: #4a7cf7;
}
.status-claimed {
  background: rgba(255, 152, 0, 0.1);
  color: #ff9800;
}
.status-submitted {
  background: rgba(156, 39, 176, 0.1);
  color: #9c27b0;
}
.status-approved {
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
}
.status-rejected {
  background: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}
.status-expired {
  background: #f5f5f5;
  color: #bbb;
}

/* 底部信息 */
.task-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.task-reward {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.reward-icon {
  font-size: 28rpx;
}
.reward-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff8c00;
  font-family: 'DIN', 'Helvetica Neue', sans-serif;
}
.task-deadline {
  font-size: 22rpx;
  color: #999;
}
.task-deadline.urgent {
  color: #ff4d4f;
  font-weight: 500;
}

/* 认领者 */
.task-claimer {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
}
.claimer-label {
  font-size: 22rpx;
  color: #666;
}

/* FAB 按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4a7cf7, #6c5ce7);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 124, 247, 0.4);
}
.fab-btn:active {
  transform: scale(0.9);
}
.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #999; margin-bottom: 32rpx; }
.btn-create-empty {
  background: #4a7cf7 !important;
  color: #fff !important;
  border: none !important;
  border-radius: 40rpx;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

/* 加载 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}
.loading-text { font-size: 26rpx; color: #999; }
.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 22rpx;
  color: #ccc;
}
