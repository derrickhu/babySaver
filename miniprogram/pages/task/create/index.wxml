<!-- 发布任务 -->
<view class="page-container">
  <!-- 模板区（编辑模式不显示） -->
  <view class="section-header" wx:if="{{!isEdit}}">
    <text class="section-title">快捷模板</text>
    <text class="section-hint">点击模板快速填入</text>
  </view>

  <view class="template-section" wx:if="{{!isEdit}}">
    <view class="template-category" wx:for="{{templates}}" wx:key="category" wx:for-index="cIndex">
      <!-- 分类头 -->
      <view class="category-header" bindtap="onToggleCategory" data-index="{{cIndex}}">
        <text class="category-icon">{{item.icon}}</text>
        <text class="category-name">{{item.category}}</text>
        <text class="category-count">{{item.tasks.length}}个</text>
        <text class="category-arrow {{expandedCategory === cIndex ? 'expanded' : ''}}">›</text>
      </view>
      <!-- 展开的模板列表 -->
      <view class="template-list" wx:if="{{expandedCategory === cIndex}}">
        <view
          class="template-item"
          wx:for="{{item.tasks}}"
          wx:key="title"
          wx:for-index="tIndex"
          data-cindex="{{cIndex}}"
          data-tindex="{{tIndex}}"
          bindtap="onSelectTemplate"
        >
          <view class="template-info">
            <text class="template-name">{{item.title}}</text>
            <text class="template-desc">{{item.description}}</text>
          </view>
          <text class="template-reward">¥{{item.reward}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 表单区 -->
  <view class="section-header" id="form-section">
    <text class="section-title">任务信息</text>
  </view>

  <view class="form-card">
    <view class="form-item">
      <text class="form-label">任务名称</text>
      <input class="form-input" placeholder="给任务起个名字" value="{{title}}" bindinput="onTitleInput" maxlength="30" />
    </view>

    <view class="form-item">
      <text class="form-label">任务描述</text>
      <textarea class="form-textarea" placeholder="描述一下任务内容..." value="{{description}}" bindinput="onDescInput" maxlength="200" />
    </view>

    <view class="form-item form-row">
      <text class="form-label">奖金（元）</text>
      <input class="form-input-inline" type="digit" placeholder="0.00" value="{{reward}}" bindinput="onRewardInput" />
    </view>

    <view class="form-item form-row">
      <text class="form-label">截止日期</text>
      <picker mode="date" value="{{deadline}}" start="{{minDate}}" bindchange="onDeadlineChange">
        <view class="form-picker">
          <text>{{deadline || '请选择'}}</text>
          <text class="picker-arrow">📅</text>
        </view>
      </picker>
    </view>
  </view>

  <button class="btn-submit" bindtap="onSubmit" disabled="{{submitting}}">
    {{submitting ? (isEdit ? '保存中...' : '发布中...') : (isEdit ? '保存修改' : '发布任务')}}
  </button>
</view>
