/* 首页 - 微众银行风格 */
.page-container {
  min-height: 100vh;
  background-color: #f5f6fa;
  padding-bottom: 120rpx;
}

/* 加载 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}
.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #4a7cf7;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #999; line-height: 1.6; }

/* 未加入家庭：创建/加入卡片（与家庭管理页一致） */
.no-family-section {
  padding-bottom: 40rpx;
}

/* 访客视图 - 产品亮点 */
.visitor-highlights {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.visitor-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #4a7cf7 0%, #6c5ce7 100%);
}
.visitor-logo {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.visitor-logo-icon {
  font-size: 64rpx;
}
.visitor-app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}
.visitor-slogan {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}
.visitor-features {
  padding: 28rpx 32rpx;
}
.visitor-feature-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}
.visitor-feature-item:last-child {
  margin-bottom: 0;
}

/* 未登录：身份选择区域 */
.role-section {
  padding: 0 24rpx;
  margin-top: 32rpx;
}
.role-section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}
.role-picker {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.role-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
  position: relative;
}
.role-card:active,
.role-card-active {
  border-color: #4a7cf7;
  background: #f0f5ff;
  box-shadow: 0 4rpx 20rpx rgba(74,124,247,0.15);
  transform: scale(0.98);
}
.role-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.role-icon-blue { background: #e8effe; }
.role-icon-orange { background: #fff4e6; }
.role-emoji {
  font-size: 44rpx;
}
.role-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.role-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
}
.role-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}
.role-arrow {
  font-size: 36rpx;
  color: #ccc;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 主动登录入口 */
.visitor-login-section {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 20rpx;
}
.visitor-login-hint {
  font-size: 26rpx;
  color: #999;
}
.visitor-login-btn {
  font-size: 26rpx;
  color: #4a7cf7;
  font-weight: 500;
  margin-left: 8rpx;
}

.setup-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 40rpx 32rpx 0;
  padding: 48rpx 36rpx;
}
.setup-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.setup-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #333;
}
.setup-desc {
  font-size: 26rpx;
  color: var(--text-hint);
  text-align: center;
  line-height: 1.8;
}
.code-input-wrap {
  width: 100%;
  margin-top: 28rpx;
}
.code-input {
  height: 88rpx;
  background: var(--bg-page);
  border-radius: 16rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
}

/* 家长无小孩 - 邀请码卡片 */
.no-child-section {
  padding: 40rpx 24rpx;
}
.no-child-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.no-child-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.no-child-label {
  font-size: 26rpx;
  color: #999;
}
.no-child-code {
  font-size: 44rpx;
  font-weight: 700;
  color: #4a7cf7;
  letter-spacing: 6rpx;
}
.no-child-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.no-child-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: none;
  padding: 0;
  margin: 0;
}
.no-child-btn.copy {
  background: #e8effe;
  color: #4a7cf7;
}
.no-child-btn.share {
  background: #4a7cf7;
  color: #fff;
}
.no-child-btn.share::after { border: none; }
.no-child-hint {
  display: block;
  font-size: 24rpx;
  color: #bbb;
  text-align: center;
}

/* 新手引导 */
.guide-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.guide-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}
.guide-list {}
.guide-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.guide-item:last-child { margin-bottom: 0; }
.guide-icon {
  font-size: 28rpx;
  color: #4a7cf7;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
  line-height: 40rpx;
}
.guide-text {
  flex: 1;
}
.guide-main {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 40rpx;
}
.guide-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 36rpx;
  margin-top: 2rpx;
}

/* 小孩切换器 */
.child-switcher {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
}
.child-switcher-inner {
  display: flex;
  align-items: center;
}
.child-switcher-avatar-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.child-switcher-avatar {
  width: 56rpx;
  height: 56rpx;
  display: block;
}
.child-switcher-emoji { font-size: 32rpx; }
.child-switcher-name { font-size: 30rpx; font-weight: 600; color: #333; }
.child-switcher-arrow { font-size: 22rpx; color: #999; margin-left: 8rpx; }
.pending-dot {
  display: flex;
  align-items: center;
  background: #ff5b5b;
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
}
.pending-num {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  margin-right: 6rpx;
}
.pending-label { font-size: 22rpx; color: #fff; }

/* 资产卡片 */
.asset-card {
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
}
.asset-card-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #4a7cf7 0%, #6c5ce7 100%);
}
.asset-card-content {
  position: relative;
  z-index: 1;
  padding: 40rpx 36rpx;
}
.asset-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}
.asset-amount {
  display: block;
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  font-family: 'DIN', 'Helvetica Neue', sans-serif;
}
.asset-detail {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
}
.asset-detail-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.asset-detail-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.2);
  margin: 0 24rpx;
}
.asset-detail-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}
.asset-detail-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 4rpx;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  padding: 32rpx 24rpx;
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-top: 24rpx;
  justify-content: space-around;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
}
.quick-icon { font-size: 44rpx; margin-bottom: 8rpx; }
.quick-label { font-size: 22rpx; color: #666; }

/* 通用卡片 */
.card {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 产品卡片 */
.product-card {
  padding: 28rpx 24rpx;
}
.product-card-header {
  display: flex;
  align-items: center;
}
.product-icon-wrap {
  width: 72rpx; height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.product-icon-blue { background: #e8effe; }
.product-icon-orange { background: #fff4e6; }
.product-icon-green { background: #e6f9f0; }
.product-icon-text { font-size: 36rpx; }
.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.product-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.product-amount-wrap {
  text-align: right;
  flex-shrink: 0;
}
.product-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  font-family: 'DIN', 'Helvetica Neue', sans-serif;
}
.product-sub {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}
.product-sub-green { color: #07c160; }
.product-matured-tag {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  text-align: center;
}
.matured-text {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
}

/* 段落标题 */
.section-title {
  padding: 32rpx 32rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 浏览理财 */
.browse-products {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
}
.browse-icon { font-size: 36rpx; margin-right: 16rpx; }
.browse-text { flex: 1; font-size: 28rpx; color: #333; font-weight: 500; }
.browse-arrow { font-size: 36rpx; color: #ccc; }

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4a7cf7, #6c5ce7);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  padding: 0 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* ========== 弹窗通用遮罩 ========== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-dialog {
  width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

/* ========== 产品亮点弹窗 ========== */
.highlights-dialog {
  animation: dialogFadeIn 0.3s ease;
}
@keyframes dialogFadeIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}
.highlights-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 24rpx;
  background: linear-gradient(135deg, #4a7cf7 0%, #6c5ce7 100%);
}
.highlights-emoji {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}
.highlights-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}
.highlights-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}
.highlights-body {
  padding: 28rpx 32rpx 16rpx;
}
.highlight-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}
.highlight-item:last-child {
  margin-bottom: 0;
}
.highlight-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.highlight-icon-blue { background: #e8effe; }
.highlight-icon-orange { background: #fff4e6; }
.highlight-icon-green { background: #e6f9f0; }
.highlight-icon-purple { background: #f3e8ff; }
.highlight-icon {
  font-size: 32rpx;
}
.highlight-text {
  flex: 1;
  padding-top: 4rpx;
}
.highlight-main {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  line-height: 40rpx;
}
.highlight-sub {
  display: block;
  font-size: 23rpx;
  color: #888;
  line-height: 34rpx;
  margin-top: 4rpx;
}
.highlights-btn {
  display: block;
  margin: 20rpx 32rpx 32rpx;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #4a7cf7, #6c5ce7);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  border-radius: 44rpx;
}
.highlights-btn::after { border: none; }
