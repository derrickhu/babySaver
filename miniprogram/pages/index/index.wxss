/* 首页样式 */
.page-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: var(--text-hint);
  font-size: 28rpx;
  margin-top: 16rpx;
}

/* 欢迎横幅 */
.welcome-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

.welcome-text {
  font-size: 34rpx;
  font-weight: 600;
  display: block;
}

.welcome-role {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
  display: block;
}

.pending-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--danger);
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
}

.pending-num {
  font-size: 36rpx;
  font-weight: 700;
}

.pending-label {
  font-size: 20rpx;
}

/* 区域标题 */
.section-title {
  padding: 24rpx 32rpx 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 存款卡片 */
.deposit-card {
  margin: 16rpx 24rpx;
}

.deposit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.child-info {
  display: flex;
  align-items: center;
}

.child-avatar {
  font-size: 44rpx;
  margin-right: 12rpx;
}

.child-name {
  font-size: 32rpx;
  font-weight: 600;
}

.deposit-body {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.deposit-item {
  flex: 1;
  text-align: center;
}

.deposit-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 8rpx;
}

.deposit-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.deposit-actions {
  display: flex;
  gap: 16rpx;
}

/* 操作入口卡片 */
.action-card {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx;
}

.action-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.action-info {
  flex: 1;
}

.action-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
}

.action-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.action-arrow {
  font-size: 40rpx;
  color: var(--text-hint);
}

/* ===== 小孩视图 ===== */

/* 总览卡片 */
.overview-card {
  position: relative;
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  color: #fff;
}

.overview-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #5B8FF9 0%, #7B68EE 100%);
}

.overview-content {
  position: relative;
  padding: 40rpx 36rpx;
}

.overview-label {
  font-size: 26rpx;
  opacity: 0.85;
  display: block;
}

.overview-amount {
  font-size: 72rpx;
  font-weight: 700;
  display: block;
  margin: 16rpx 0 32rpx;
  letter-spacing: 2rpx;
}

.overview-detail {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.detail-item {
  flex: 1;
  text-align: center;
}

.detail-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.detail-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.detail-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 利率卡片 */
.rate-card {
  display: flex;
  justify-content: space-around;
  padding: 28rpx 24rpx;
}

.rate-info {
  text-align: center;
}

.rate-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 8rpx;
}

.rate-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  padding: 24rpx;
  gap: 24rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: var(--shadow);
}

.quick-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.quick-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}
