/* 首页 - 微众银行风格 */
.page-container {
  min-height: 100vh;
  background-color: #f5f6fa;
  padding-bottom: 120rpx;
}

/* 加载 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}
.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #4a7cf7;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #999; line-height: 1.6; }

/* 小孩切换器 */
.child-switcher {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
}
.child-switcher-inner {
  display: flex;
  align-items: center;
}
.child-switcher-emoji { font-size: 36rpx; margin-right: 12rpx; }
.child-switcher-name { font-size: 30rpx; font-weight: 600; color: #333; }
.child-switcher-arrow { font-size: 22rpx; color: #999; margin-left: 8rpx; }
.pending-dot {
  display: flex;
  align-items: center;
  background: #ff5b5b;
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
}
.pending-num {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  margin-right: 6rpx;
}
.pending-label { font-size: 22rpx; color: #fff; }

/* 资产卡片 */
.asset-card {
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
}
.asset-card-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #4a7cf7 0%, #6c5ce7 100%);
}
.asset-card-content {
  position: relative;
  z-index: 1;
  padding: 40rpx 36rpx;
}
.asset-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}
.asset-amount {
  display: block;
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  font-family: 'DIN', 'Helvetica Neue', sans-serif;
}
.asset-detail {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
}
.asset-detail-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.asset-detail-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.2);
  margin: 0 24rpx;
}
.asset-detail-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}
.asset-detail-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 4rpx;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  padding: 32rpx 24rpx;
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-top: 24rpx;
  justify-content: space-around;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
}
.quick-icon { font-size: 44rpx; margin-bottom: 8rpx; }
.quick-label { font-size: 22rpx; color: #666; }

/* 通用卡片 */
.card {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 产品卡片 */
.product-card {
  padding: 28rpx 24rpx;
}
.product-card-header {
  display: flex;
  align-items: center;
}
.product-icon-wrap {
  width: 72rpx; height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.product-icon-blue { background: #e8effe; }
.product-icon-orange { background: #fff4e6; }
.product-icon-green { background: #e6f9f0; }
.product-icon-text { font-size: 36rpx; }
.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.product-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.product-amount-wrap {
  text-align: right;
  flex-shrink: 0;
}
.product-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  font-family: 'DIN', 'Helvetica Neue', sans-serif;
}
.product-sub {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}
.product-sub-green { color: #07c160; }
.product-matured-tag {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  text-align: center;
}
.matured-text {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
}

/* 段落标题 */
.section-title {
  padding: 32rpx 32rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 浏览理财 */
.browse-products {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
}
.browse-icon { font-size: 36rpx; margin-right: 16rpx; }
.browse-text { flex: 1; font-size: 28rpx; color: #333; font-weight: 500; }
.browse-arrow { font-size: 36rpx; color: #ccc; }

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4a7cf7, #6c5ce7);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  padding: 0 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}
