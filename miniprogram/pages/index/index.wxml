<!-- 首页 - 资产总览（微众银行风格） -->
<view class="page-container">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 未加入家庭 -->
  <view wx:elif="{{!hasFamily}}" class="empty-state">
    <text class="empty-icon">🏠</text>
    <text class="empty-text">您还未加入家庭</text>
    <text class="empty-text" style="margin-bottom: 40rpx;">请先{{isParent ? '创建' : '加入'}}家庭</text>
    <button class="btn-primary" style="width: 400rpx;" bindtap="goFamily">
      {{isParent ? '创建家庭' : '加入家庭'}}
    </button>
  </view>

  <block wx:else>
    <!-- 家长：小孩选择器 -->
    <view class="child-switcher" wx:if="{{isParent && children.length > 0}}">
      <picker bindchange="onChildChange" value="{{selectedChildIndex}}" range="{{children}}" range-key="nickName">
        <view class="child-switcher-inner">
          <text class="child-switcher-emoji">🧒</text>
          <text class="child-switcher-name">{{children[selectedChildIndex].nickName}}</text>
          <text class="child-switcher-arrow">▼</text>
        </view>
      </picker>
      <!-- 待审批 -->
      <view class="pending-dot" bindtap="goReview" wx:if="{{pendingCount > 0}}">
        <text class="pending-num">{{pendingCount}}</text>
        <text class="pending-label">待审批</text>
      </view>
    </view>

    <!-- 家长无小孩 - 引导邀请 -->
    <view wx:if="{{isParent && children.length === 0}}" class="onboard-section">
      <!-- 顶部欢迎卡 -->
      <view class="onboard-welcome">
        <view class="onboard-welcome-bg"></view>
        <view class="onboard-welcome-content">
          <text class="onboard-hello">👋 你好，{{userInfo.nickName}}</text>
          <text class="onboard-title">家庭创建成功</text>
          <text class="onboard-subtitle">接下来邀请小孩加入，即可开始理财之旅</text>
        </view>
      </view>

      <!-- 邀请码卡片 -->
      <view class="onboard-invite-card" wx:if="{{inviteCode}}">
        <view class="onboard-invite-header">
          <text class="onboard-invite-title">家庭邀请码</text>
          <text class="onboard-invite-copy" bindtap="onCopyInviteCode">复制</text>
        </view>
        <text class="onboard-invite-code">{{inviteCode}}</text>
        <text class="onboard-invite-hint">小孩在小程序中输入此邀请码即可加入</text>
      </view>

      <!-- 邀请到微信群 -->
      <button class="onboard-share-btn" open-type="share">
        <text class="onboard-share-icon">💬</text>
        <view class="onboard-share-info">
          <text class="onboard-share-title">邀请到微信群</text>
          <text class="onboard-share-desc">发到家庭群，成员打开即可加入</text>
        </view>
        <text class="onboard-share-arrow">›</text>
      </button>

      <!-- 使用指南 -->
      <view class="onboard-steps">
        <text class="onboard-steps-title">如何开始使用？</text>
        <view class="onboard-step-item">
          <view class="step-num">1</view>
          <view class="step-content">
            <text class="step-title">邀请小孩加入家庭</text>
            <text class="step-desc">通过微信群或邀请码，让小孩加入您的家庭</text>
          </view>
        </view>
        <view class="onboard-step-item">
          <view class="step-num">2</view>
          <view class="step-content">
            <text class="step-title">为小孩存入资金</text>
            <text class="step-desc">设置存款金额，系统将自动计算每日收益</text>
          </view>
        </view>
        <view class="onboard-step-item">
          <view class="step-num">3</view>
          <view class="step-content">
            <text class="step-title">小孩查看收益、学会理财</text>
            <text class="step-desc">小孩可随时查看存款和收益，培养理财意识</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 资产总览卡片 -->
    <block wx:if="{{account || (!isParent)}}">
      <view class="asset-card">
        <view class="asset-card-bg"></view>
        <view class="asset-card-content">
          <text class="asset-label">总资产（元）</text>
          <text class="asset-amount">{{totalAssets}}</text>
          <view class="asset-detail">
            <view class="asset-detail-item">
              <text class="asset-detail-label">累计收益</text>
              <text class="asset-detail-value">+{{totalEarnings}}</text>
            </view>
            <view class="asset-detail-divider"></view>
            <view class="asset-detail-item">
              <text class="asset-detail-label">昨日收益</text>
              <text class="asset-detail-value">+{{yesterdayEarnings}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 快捷操作 -->
      <view class="quick-actions">
        <view class="quick-item" bindtap="goEarningsCalendar">
          <text class="quick-icon">📅</text>
          <text class="quick-label">收益</text>
        </view>
        <view class="quick-item" bindtap="goBills">
          <text class="quick-icon">📄</text>
          <text class="quick-label">账单</text>
        </view>
        <view class="quick-item" bindtap="goDeposit" wx:if="{{isParent && canDeposit}}">
          <text class="quick-icon">💰</text>
          <text class="quick-label">存入</text>
        </view>
        <view class="quick-item" bindtap="goWithdraw" wx:if="{{!isParent}}">
          <text class="quick-icon">💳</text>
          <text class="quick-label">取现</text>
        </view>
        <view class="quick-item" bindtap="goProductManage" wx:if="{{isParent && canProductManage}}">
          <text class="quick-icon">⚙️</text>
          <text class="quick-label">产品管理</text>
        </view>
        <view class="quick-item" bindtap="goReview" wx:if="{{isParent && canReview && pendingCount > 0}}">
          <text class="quick-icon">📋</text>
          <text class="quick-label">审批</text>
        </view>
      </view>

      <!-- 默认账户 -->
      <view class="product-card card" wx:if="{{account}}">
        <view class="product-card-header">
          <view class="product-icon-wrap product-icon-blue">
            <text class="product-icon-text">💳</text>
          </view>
          <view class="product-info">
            <text class="product-name">默认账户</text>
            <text class="product-desc">年化 {{account.baseRate}}%  日收益 +{{account.dailyEarningStr}}</text>
          </view>
          <view class="product-amount-wrap">
            <text class="product-amount">{{account.totalValueStr}}</text>
            <text class="product-sub" wx:if="{{account.totalEarnings > 0}}">累计收益 +{{account.earningsStr}}</text>
          </view>
        </view>
      </view>

      <!-- 理财持仓列表 -->
      <view class="section-title" wx:if="{{investments.length > 0}}">
        <text>理财持仓</text>
      </view>

      <view
        class="product-card card"
        wx:for="{{investments}}"
        wx:key="_id"
        data-productid="{{item.productId}}"
        data-investmentid="{{item._id}}"
        bindtap="goProductDetail"
      >
        <view class="product-card-header">
          <view class="product-icon-wrap {{item.status === 'matured' ? 'product-icon-green' : 'product-icon-orange'}}">
            <text class="product-icon-text">{{item.endDate ? '⏱' : '📈'}}</text>
          </view>
          <view class="product-info">
            <text class="product-name">{{item.productName}}</text>
            <text class="product-desc">年化 {{item.rateStr}}  日收益 +{{item.dailyEarningStr}}{{item.endDate ? '  到期 ' + item.endDate : ''}}</text>
          </view>
          <view class="product-amount-wrap">
            <text class="product-amount">{{item.totalValueStr}}</text>
            <text class="product-sub product-sub-green">累计收益 +{{item.earningsStr}}</text>
          </view>
        </view>
        <view class="product-matured-tag" wx:if="{{item.status === 'matured'}}">
          <text class="matured-text">已到期，收益持续中，可随时赎回</text>
        </view>
      </view>

      <!-- 浏览理财产品入口（小孩） -->
      <view class="browse-products card" bindtap="goProducts" wx:if="{{!isParent}}">
        <text class="browse-icon">🛒</text>
        <text class="browse-text">浏览理财产品</text>
        <text class="browse-arrow">›</text>
      </view>

      <!-- 无任何资产 -->
      <view class="empty-state" wx:if="{{!account && investments.length === 0 && !isParent}}" style="padding-top: 60rpx;">
        <text class="empty-icon">🐷</text>
        <text class="empty-text">还没有资产记录</text>
        <text class="empty-text">请等待家长为你存入资金</text>
      </view>
    </block>
  </block>
</view>
