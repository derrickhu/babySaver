<!-- 首页 - 资产总览（微众银行风格） -->
<view class="page-container">
  <!-- 产品亮点弹窗 -->
  <view class="modal-mask" wx:if="{{showHighlights}}" catchtouchmove="true">
    <view class="modal-dialog highlights-dialog">
      <view class="highlights-header">
        <text class="highlights-emoji">🎉</text>
        <text class="highlights-title">欢迎使用小孩存钱宝</text>
        <text class="highlights-subtitle">记录每一笔收入和支出，用虚拟理财培养财商</text>
      </view>
      <view class="highlights-body">
        <view class="highlight-item">
          <view class="highlight-icon-wrap highlight-icon-blue">
            <text class="highlight-icon">📒</text>
          </view>
          <view class="highlight-text">
            <text class="highlight-main">收支全记录</text>
            <text class="highlight-sub">压岁钱、零花钱、奖励收入，以及每笔消费支出，清清楚楚有据可查</text>
          </view>
        </view>
        <view class="highlight-item">
          <view class="highlight-icon-wrap highlight-icon-orange">
            <text class="highlight-icon">🏦</text>
          </view>
          <view class="highlight-text">
            <text class="highlight-main">虚拟理财体验</text>
            <text class="highlight-sub">收到的钱可存入虚拟银行，参照真实利率按天计息，让孩子体会"钱生钱"</text>
          </view>
        </view>
        <view class="highlight-item">
          <view class="highlight-icon-wrap highlight-icon-green">
            <text class="highlight-icon">🎯</text>
          </view>
          <view class="highlight-text">
            <text class="highlight-main">任务赚奖励</text>
            <text class="highlight-sub">家长发布家务、学习任务，孩子完成即可赚取奖励，培养劳动价值观</text>
          </view>
        </view>
        <view class="highlight-item">
          <view class="highlight-icon-wrap highlight-icon-purple">
            <text class="highlight-icon">👨‍👩‍👧‍👦</text>
          </view>
          <view class="highlight-text">
            <text class="highlight-main">家长审批花钱</text>
            <text class="highlight-sub">孩子想花钱需提交申请，家长审批通过后才可使用，花钱有节制</text>
          </view>
        </view>
      </view>
      <button class="highlights-btn" bindtap="onCloseHighlights">开始使用</button>
    </view>
  </view>

  <!-- 新手指引遮罩 -->
  <view class="modal-mask guide-mask" wx:if="{{showGuide}}" catchtouchmove="true">
    <view class="guide-modal">
      <!-- 步骤指示器 -->
      <view class="guide-steps-bar">
        <view class="guide-step-dot {{guideStep >= 0 ? 'active' : ''}}"></view>
        <view class="guide-step-dot {{guideStep >= 1 ? 'active' : ''}}"></view>
        <view class="guide-step-dot {{guideStep >= 2 ? 'active' : ''}}"></view>
      </view>

      <!-- 步骤内容 -->
      <view class="guide-content" wx:if="{{guideStep === 0}}">
        <text class="guide-modal-emoji">📤</text>
        <text class="guide-modal-title">第1步：邀请小孩加入</text>
        <text class="guide-modal-desc">复制上方的家庭邀请码，发给孩子\n孩子打开小程序，输入邀请码即可加入家庭</text>
      </view>
      <view class="guide-content" wx:if="{{guideStep === 1}}">
        <text class="guide-modal-emoji">💰</text>
        <text class="guide-modal-title">第2步：为孩子存入资金</text>
        <text class="guide-modal-desc">孩子加入后，在首页点击「存入」为孩子存入虚拟资金\n系统会按设定的利率自动每天计息</text>
      </view>
      <view class="guide-content" wx:if="{{guideStep === 2}}">
        <text class="guide-modal-emoji">🎊</text>
        <text class="guide-modal-title">第3步：开始理财之旅</text>
        <text class="guide-modal-desc">孩子可以查看收益增长，申请取现消费\n您可以发布任务让孩子赚取额外奖励</text>
      </view>

      <!-- 操作按钮 -->
      <view class="guide-modal-actions">
        <text class="guide-skip-btn" bindtap="onGuideSkip">跳过</text>
        <button class="guide-next-btn" bindtap="onGuideNext">
          {{guideStep >= 2 ? '完成' : '下一步'}}
        </button>
      </view>
    </view>
  </view>
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 未加入家庭：与家庭管理页一致，展示创建和加入 -->
  <view wx:elif="{{!hasFamily}}" class="no-family-section">
    <!-- 家长：创建家庭 + 加入已有家庭 -->
    <block wx:if="{{isParent}}">
      <view class="setup-card card">
        <text class="setup-icon">🏠</text>
        <text class="setup-title">创建您的家庭</text>
        <text class="setup-desc">创建后，将生成邀请码\n小孩和其他家长输入邀请码即可加入</text>
        <button class="btn-primary" style="width: 100%; margin-top: 40rpx;" bindtap="onCreateFamily">创建家庭</button>
      </view>
      <view class="setup-card card">
        <text class="setup-icon">🔗</text>
        <text class="setup-title">加入已有家庭</text>
        <text class="setup-desc">如果其他家长已创建家庭，输入邀请码即可加入</text>
        <view class="code-input-wrap">
          <input
            class="code-input"
            placeholder="请输入6位邀请码"
            value="{{inputCode}}"
            bindinput="onCodeInput"
            maxlength="6"
          />
        </view>
        <button class="btn-secondary" style="width: 100%; margin-top: 32rpx;" bindtap="onJoinFamily">加入家庭</button>
      </view>
    </block>
    <!-- 小孩：加入家庭 -->
    <block wx:else>
      <view class="setup-card card">
        <text class="setup-icon">🔗</text>
        <text class="setup-title">加入家庭</text>
        <text class="setup-desc">输入家长分享的邀请码加入家庭</text>
        <view class="code-input-wrap">
          <input
            class="code-input"
            placeholder="请输入6位邀请码"
            value="{{inputCode}}"
            bindinput="onCodeInput"
            maxlength="6"
          />
        </view>
        <button class="btn-primary" style="width: 100%; margin-top: 32rpx;" bindtap="onJoinFamily">加入家庭</button>
      </view>
    </block>
  </view>

  <block wx:else>
    <!-- 家长：小孩选择器 -->
    <view class="child-switcher" wx:if="{{isParent && children.length > 0}}">
      <picker bindchange="onChildChange" value="{{selectedChildIndex}}" range="{{children}}" range-key="nickName">
        <view class="child-switcher-inner">
          <view class="child-switcher-avatar-wrap">
            <image
              class="child-switcher-avatar"
              wx:if="{{children[selectedChildIndex].avatarUrl && !children[selectedChildIndex].avatarError}}"
              src="{{children[selectedChildIndex].avatarUrl}}"
              mode="aspectFill"
              binderror="onChildAvatarError"
              data-index="{{selectedChildIndex}}"
            ></image>
            <text class="child-switcher-emoji" wx:else>🧒</text>
          </view>
          <text class="child-switcher-name">{{children[selectedChildIndex].nickName}}</text>
          <text class="child-switcher-arrow">▼</text>
        </view>
      </picker>
      <!-- 待审批 -->
      <view class="pending-dot" bindtap="goReview" wx:if="{{pendingCount > 0}}">
        <text class="pending-num">{{pendingCount}}</text>
        <text class="pending-label">待审批</text>
      </view>
    </view>

    <!-- 家长无小孩 -->
    <view wx:if="{{isParent && children.length === 0}}" class="no-child-section">
      <!-- 邀请码卡片 -->
      <view class="no-child-card" wx:if="{{inviteCode}}">
        <view class="no-child-top">
          <text class="no-child-label">家庭邀请码</text>
          <text class="no-child-code">{{inviteCode}}</text>
        </view>
        <view class="no-child-actions">
          <text class="no-child-btn copy" bindtap="onCopyInviteCode">复制</text>
          <button class="no-child-btn share" open-type="share">邀请</button>
        </view>
        <text class="no-child-hint">小孩打开小程序输入邀请码即可加入</text>
      </view>

      <!-- 新手引导 -->
      <view class="guide-card">
        <text class="guide-title">3 步开始使用</text>
        <view class="guide-list">
          <view class="guide-item">
            <view class="guide-icon">①</view>
            <view class="guide-text">
              <text class="guide-main">邀请小孩加入</text>
              <text class="guide-sub">复制邀请码或直接分享到微信群</text>
            </view>
          </view>
          <view class="guide-item">
            <view class="guide-icon">②</view>
            <view class="guide-text">
              <text class="guide-main">设置存款与利率</text>
              <text class="guide-sub">为小孩存入资金，系统自动按天计息</text>
            </view>
          </view>
          <view class="guide-item">
            <view class="guide-icon">③</view>
            <view class="guide-text">
              <text class="guide-main">小孩查看收益</text>
              <text class="guide-sub">随时查看本金、利息和收益趋势</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 资产总览卡片 -->
    <block wx:if="{{account || (!isParent)}}">
      <view class="asset-card">
        <view class="asset-card-bg"></view>
        <view class="asset-card-content">
          <text class="asset-label">总资产（元）</text>
          <text class="asset-amount">{{totalAssets}}</text>
          <view class="asset-detail">
            <view class="asset-detail-item">
              <text class="asset-detail-label">累计收益</text>
              <text class="asset-detail-value">+{{totalEarnings}}</text>
            </view>
            <view class="asset-detail-divider"></view>
            <view class="asset-detail-item">
              <text class="asset-detail-label">昨日收益</text>
              <text class="asset-detail-value">+{{yesterdayEarnings}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 快捷操作 -->
      <view class="quick-actions">
        <view class="quick-item" bindtap="goEarningsCalendar">
          <text class="quick-icon">📅</text>
          <text class="quick-label">收益</text>
        </view>
        <view class="quick-item" bindtap="goBills">
          <text class="quick-icon">📄</text>
          <text class="quick-label">账单</text>
        </view>
        <view class="quick-item" bindtap="goDeposit" wx:if="{{isParent && canDeposit}}">
          <text class="quick-icon">💰</text>
          <text class="quick-label">存入</text>
        </view>
        <view class="quick-item" bindtap="goWithdraw" wx:if="{{!isParent}}">
          <text class="quick-icon">💳</text>
          <text class="quick-label">取现</text>
        </view>
        <view class="quick-item" bindtap="goProductManage" wx:if="{{isParent && canProductManage}}">
          <text class="quick-icon">⚙️</text>
          <text class="quick-label">产品管理</text>
        </view>
        <view class="quick-item" bindtap="goReview" wx:if="{{isParent && canReview && pendingCount > 0}}">
          <text class="quick-icon">✅</text>
          <text class="quick-label">审批</text>
        </view>
      </view>

      <!-- 默认账户 -->
      <view class="product-card card" wx:if="{{account}}">
        <view class="product-card-header">
          <view class="product-icon-wrap product-icon-blue">
            <text class="product-icon-text">💳</text>
          </view>
          <view class="product-info">
            <text class="product-name">默认账户</text>
            <text class="product-desc">年化 {{account.baseRate}}%  日收益 +{{account.dailyEarningStr}}</text>
          </view>
          <view class="product-amount-wrap">
            <text class="product-amount">{{account.totalValueStr}}</text>
            <text class="product-sub" wx:if="{{account.totalEarnings > 0}}">累计收益 +{{account.earningsStr}}</text>
          </view>
        </view>
      </view>

      <!-- 理财持仓列表 -->
      <view class="section-title" wx:if="{{investments.length > 0}}">
        <text>理财持仓</text>
      </view>

      <view
        class="product-card card"
        wx:for="{{investments}}"
        wx:key="_id"
        data-productid="{{item.productId}}"
        data-investmentid="{{item._id}}"
        bindtap="goProductDetail"
      >
        <view class="product-card-header">
          <view class="product-icon-wrap {{item.status === 'matured' ? 'product-icon-green' : 'product-icon-orange'}}">
            <text class="product-icon-text">{{item.endDate ? '⏱' : '📈'}}</text>
          </view>
          <view class="product-info">
            <text class="product-name">{{item.productName}}</text>
            <text class="product-desc">年化 {{item.rateStr}}  日收益 +{{item.dailyEarningStr}}{{item.endDate ? '  到期 ' + item.endDate : ''}}</text>
          </view>
          <view class="product-amount-wrap">
            <text class="product-amount">{{item.totalValueStr}}</text>
            <text class="product-sub product-sub-green">累计收益 +{{item.earningsStr}}</text>
          </view>
        </view>
        <view class="product-matured-tag" wx:if="{{item.status === 'matured'}}">
          <text class="matured-text">已到期，收益持续中，可随时赎回</text>
        </view>
      </view>

      <!-- 浏览理财产品入口（小孩） -->
      <view class="browse-products card" bindtap="goProducts" wx:if="{{!isParent}}">
        <text class="browse-icon">🛒</text>
        <text class="browse-text">浏览理财产品</text>
        <text class="browse-arrow">›</text>
      </view>

      <!-- 无任何资产 -->
      <view class="empty-state" wx:if="{{!account && investments.length === 0 && !isParent}}" style="padding-top: 60rpx;">
        <text class="empty-icon">🐷</text>
        <text class="empty-text">还没有资产记录</text>
        <text class="empty-text">请等待家长为你存入资金</text>
      </view>
    </block>
  </block>
</view>
