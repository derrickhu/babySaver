<view class="page sub">
  <filter-bar show-window="{{false}}" bind:change="onFilter" />
  <view class="dates">
    <picker mode="date" value="{{fromDate}}" bindchange="onFrom">
      <view class="date-chip">从 {{fromDate}}</view>
    </picker>
    <picker mode="date" value="{{toDate}}" bindchange="onTo">
      <view class="date-chip">到 {{toDate}}</view>
    </picker>
  </view>
  <scroll-view scroll-x class="segs" enhanced show-scrollbar="{{false}}">
    <view class="seg {{segment === item.key ? 'on' : ''}}" wx:for="{{segments}}" wx:key="key" data-v="{{item.key}}" bindtap="onSegment">{{item.label}}</view>
  </scroll-view>
  <report loading="{{loading}}" refreshing="{{refreshing}}" error="{{error}}" sections="{{sections}}" />
</view>
