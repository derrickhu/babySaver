<!-- 取现申请页 -->
<view class="withdraw-page">
  <!-- 可用余额 -->
  <view class="balance-card" wx:if="{{account}}">
    <text class="balance-label">可取金额（元）</text>
    <text class="balance-amount">{{account.totalStr}}</text>
    <view class="balance-detail">
      <text>账户余额 ¥{{account.balanceStr}}</text>
      <text style="margin-left: 24rpx;">收益 ¥{{account.earningsStr}}</text>
    </view>
  </view>

  <!-- 申请表单 -->
  <view class="card form-card" wx:if="{{account}}">
    <view class="form-item">
      <view class="form-label-row">
        <text class="form-label">取现金额（元）</text>
        <text class="link" bindtap="onTakeAll">全部取出</text>
      </view>
      <input
        class="form-input amount-input"
        type="digit"
        placeholder="请输入取现金额"
        value="{{amount}}"
        bindinput="onAmountInput"
      />
    </view>

    <!-- 取现用途标签 -->
    <view class="form-item">
      <text class="form-label">用途</text>
      <view class="tag-grid">
        <view
          class="tag-item {{selectedTag === item.key ? 'tag-active' : ''}}"
          wx:for="{{withdrawTags}}"
          wx:key="key"
          bindtap="onSelectTag"
          data-key="{{item.key}}"
        >
          <text class="tag-icon">{{item.icon}}</text>
          <text class="tag-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">备注</text>
      <textarea
        class="form-textarea"
        placeholder="选填，补充说明..."
        value="{{remark}}"
        bindinput="onRemarkInput"
        maxlength="100"
      />
    </view>

    <button
      class="btn-primary"
      style="margin-top: 32rpx;"
      bindtap="onSubmit"
      disabled="{{submitting}}"
    >
      {{submitting ? '提交中...' : '提交取现申请'}}
    </button>

    <text class="form-tip" style="text-align: center; margin-top: 16rpx; display: block;">
      提交后需要家长审批通过才可取现
    </text>
  </view>

  <!-- 无账户 -->
  <view class="empty-state" wx:if="{{!account && !loading}}">
    <text class="empty-icon">🐷</text>
    <text class="empty-text">暂无可取现的余额</text>
  </view>

  <!-- 历史记录 -->
  <view class="history-section" wx:if="{{history.length > 0}}">
    <view class="section-title">取现记录</view>
    <view class="card">
      <view class="history-item" wx:for="{{history}}" wx:key="_id">
        <view class="history-info">
          <view class="history-top-row">
            <text class="history-amount">¥{{item.amountStr}}</text>
            <text class="history-tag-badge" wx:if="{{item.tagLabel}}">{{item.tagIcon}} {{item.tagLabel}}</text>
          </view>
          <text class="history-time">{{item.timeStr}}</text>
        </view>
        <view class="history-right">
          <text class="tag tag-{{item.status}}">{{item.statusText}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
