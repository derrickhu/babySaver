/* 取现申请页样式 */
.withdraw-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 余额卡片 */
.balance-card {
  background: linear-gradient(135deg, #FFB800, #FF8C00);
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  color: #fff;
}

.balance-label {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
}

.balance-amount {
  font-size: 64rpx;
  font-weight: 700;
  display: block;
  margin: 12rpx 0;
}

.balance-detail {
  font-size: 24rpx;
  opacity: 0.85;
}

/* 表单 */
.form-card {
  margin: 0 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.form-label-row .form-label {
  margin-bottom: 0;
}

.form-input {
  height: 88rpx;
  background: var(--bg-page);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.amount-input {
  font-size: 40rpx;
  font-weight: 600;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: var(--bg-page);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-tip {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 历史记录 */
.history-section {
  margin-top: 40rpx;
}

.section-title {
  padding: 0 32rpx 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.history-item:last-child {
  border-bottom: none;
}

.history-amount {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.history-time {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.history-right {
  display: flex;
  align-items: center;
}
