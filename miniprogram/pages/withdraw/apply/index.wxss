/* 取现申请页样式 */
.withdraw-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 余额卡片 */
.balance-card {
  background: linear-gradient(135deg, #FFB800, #FF8C00);
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  color: #fff;
}

.balance-label {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
}

.balance-amount {
  font-size: 64rpx;
  font-weight: 700;
  display: block;
  margin: 12rpx 0;
}

.balance-detail {
  font-size: 24rpx;
  opacity: 0.85;
}

/* 表单 */
.form-card {
  margin: 0 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.form-label-row .form-label {
  margin-bottom: 0;
}

.form-input {
  height: 88rpx;
  background: var(--bg-page);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.amount-input {
  font-size: 40rpx;
  font-weight: 600;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: var(--bg-page);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-tip {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 标签选择 */
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}
.tag-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc((100% - 64rpx) / 5);
  height: 120rpx;
  background: #f5f6fa;
  border-radius: 16rpx;
  transition: all 0.2s;
  border: 2rpx solid transparent;
}
.tag-item:active {
  transform: scale(0.95);
}
.tag-active {
  background: rgba(255, 184, 0, 0.12);
  border-color: #FFB800;
}
.tag-active .tag-label {
  color: #FF8C00;
  font-weight: 600;
}
.tag-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}
.tag-label {
  font-size: 22rpx;
  color: #666;
  white-space: nowrap;
}

/* 历史记录 */
.history-top-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.history-tag-badge {
  font-size: 20rpx;
  color: #FF8C00;
  background: rgba(255, 184, 0, 0.12);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.history-section {
  margin-top: 40rpx;
}

.section-title {
  padding: 0 32rpx 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.history-item:last-child {
  border-bottom: none;
}

.history-amount {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.history-time {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.history-right {
  display: flex;
  align-items: center;
}
