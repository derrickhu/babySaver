/* 取现审批页样式 */
.review-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* Tab */
.tab-bar {
  display: flex;
  background: var(--bg-card);
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 12rpx;
  gap: 8rpx;
}

.tab-item.active {
  background: var(--primary);
  color: #fff;
  font-weight: 500;
}

.tab-badge {
  background: var(--danger);
  color: #fff;
  font-size: 22rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 36rpx;
  padding: 0 8rpx;
}

.tab-item.active .tab-badge {
  background: rgba(255, 255, 255, 0.3);
}

/* 审批卡片 */
.review-card {
  margin: 16rpx 24rpx;
}

.review-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.review-child {
  display: flex;
  align-items: center;
}

.child-avatar-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.child-avatar-wrap.small {
  width: 48rpx;
  height: 48rpx;
}
.child-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.child-avatar-emoji {
  font-size: 32rpx;
}
.child-avatar-wrap.small .child-avatar-emoji {
  font-size: 24rpx;
}

.child-name {
  font-size: 30rpx;
  font-weight: 600;
}

.review-amount {
  text-align: center;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--border);
  border-bottom: 1rpx solid var(--border);
}

.amount-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 8rpx;
}

.amount-value {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--accent);
}

/* 用途标签 */
.review-tag {
  display: flex;
  align-items: center;
  padding: 16rpx 0 0;
  font-size: 26rpx;
}
.tag-label-text {
  color: var(--text-hint);
  margin-right: 8rpx;
}
.tag-badge {
  display: inline-block;
  background: rgba(255, 184, 0, 0.12);
  color: #FF8C00;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.history-tag {
  font-size: 22rpx;
  color: #FF8C00;
  background: rgba(255, 184, 0, 0.12);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.review-reason {
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.reason-label {
  color: var(--text-hint);
}

.review-time {
  font-size: 24rpx;
  color: var(--text-hint);
  padding: 8rpx 0 16rpx;
}

.review-actions {
  display: flex;
  gap: 24rpx;
  padding-top: 16rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.reject-btn {
  background: #FFF1F0 !important;
  color: var(--danger) !important;
}

.approve-btn {
  background: #52C41A !important;
  color: #fff !important;
}

/* 历史卡片 */
.history-card {
  margin: 16rpx 24rpx;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.history-child {
  font-size: 28rpx;
}

.history-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-amount {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.history-time {
  font-size: 24rpx;
  color: var(--text-hint);
}

.history-reason {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}
