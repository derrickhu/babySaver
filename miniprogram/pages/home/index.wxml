<view class="home" bindtap="onBlank">
  <view class="hero">
    <view class="hero-top">
      <view class="hero-label">{{heroLabel}}</view>
    </view>
    <view class="hero-value">¥{{heroValue}}</view>
    <view class="hero-split">
      <view class="split">
        <text class="split-k">微信</text>
        <text class="split-v">¥{{heroWx}}</text>
      </view>
      <view class="split-rule"></view>
      <view class="split">
        <text class="split-k">抖音</text>
        <text class="split-v">¥{{heroDy}}</text>
      </view>
    </view>
  </view>

  <view class="sheet">
    <view class="sheet-head">
      <view>
        <view class="sheet-title">{{chartTitle}}<text wx:if="{{refreshing}}" class="live"> 更新中</text></view>
        <view class="sheet-sum">区间合计 ¥{{rangeText}}</view>
        <view wx:if="{{trendNote}}" class="sheet-note {{trendUp ? 'up' : 'down'}}">{{trendNote}}</view>
      </view>
      <view class="grain">
        <view class="g {{grain === 'yesterday' ? 'on' : ''}}" data-v="yesterday" bindtap="onGrain">昨日</view>
        <view class="g {{grain === 'mtd' ? 'on' : ''}}" data-v="mtd" bindtap="onGrain">当月</view>
        <view class="g {{grain === 'month30' ? 'on' : ''}}" data-v="month30" bindtap="onGrain">近一月</view>
        <view class="g {{grain === 'year' ? 'on' : ''}}" data-v="year" bindtap="onGrain">近一年</view>
      </view>
    </view>

    <view class="chart-wrap" catchtap="onHold">
      <canvas
        type="2d"
        id="trend"
        class="chart"
        bindtouchstart="onScrub"
        bindtouchmove="onScrub"
        bindtouchend="onScrub"
        bindtouchcancel="onScrub"
      ></canvas>
      <view wx:if="{{tip.show}}" class="tip" style="left: {{tip.left}}px; top: {{tip.top}}px;">
        <view class="tip-date">{{tip.date}}</view>
        <view class="tip-val">¥{{tip.value}}</view>
        <view wx:if="{{tip.extra}}" class="tip-sub">{{tip.extra}}</view>
      </view>
      <view wx:if="{{loading && !games.length}}" class="mask">正在读取云上数据…</view>
      <view wx:elif="{{error}}" class="mask error">{{error}}</view>
      <view wx:elif="{{empty}}" class="mask">这段时间还没有收入</view>
    </view>

    <view class="legend" wx:if="{{!loading && !error && !empty}}">
      <block wx:if="{{channel === 'total'}}">
        <view class="lg"><view class="swatch s-total"></view>合计</view>
        <view class="lg"><view class="swatch s-wx"></view>微信</view>
        <view class="lg"><view class="swatch s-dy"></view>抖音</view>
      </block>
      <view class="lg hint">{{scrubHint}}</view>
    </view>

    <view class="segbar">
      <view class="seg {{channel === 'total' ? 'on' : ''}}" data-v="total" bindtap="onChannel">总收入</view>
      <view class="seg {{channel === 'wechat' ? 'on' : ''}}" data-v="wechat" bindtap="onChannel">微信</view>
      <view class="seg {{channel === 'douyin' ? 'on' : ''}}" data-v="douyin" bindtap="onChannel">抖音</view>
    </view>
  </view>

  <view class="sheet sheet-next">
    <view class="sheet-head">
      <view>
        <view class="sheet-title">全部游戏</view>
        <view class="activity-kpis">
          <view class="activity-kpi">
            <text class="activity-k">{{dauKpiLabel}}</text>
            <text class="activity-v">{{todayDau}}<text class="activity-u"> 人</text></text>
          </view>
          <view class="activity-kpi">
            <text class="activity-k">{{adsKpiLabel}}</text>
            <text class="activity-v">{{todayAds}}<text class="activity-u"> 次</text></text>
          </view>
        </view>
        <view wx:if="{{activityCurveText}}" class="sheet-sum">{{activityCurveText}}</view>
      </view>
      <view class="grain">
        <view class="g {{activityMetric === 'dau' ? 'on' : ''}}" data-v="dau" bindtap="onActivity">日活</view>
        <view class="g {{activityMetric === 'ads' ? 'on' : ''}}" data-v="ads" bindtap="onActivity">曝光</view>
      </view>
    </view>

    <view class="chart-wrap" catchtap="onHold">
      <canvas
        type="2d"
        id="activity"
        class="chart"
        bindtouchstart="onActivityScrub"
        bindtouchmove="onActivityScrub"
        bindtouchend="onActivityScrub"
        bindtouchcancel="onActivityScrub"
      ></canvas>
      <view wx:if="{{activityTip.show}}" class="tip" style="left: {{activityTip.left}}px; top: {{activityTip.top}}px;">
        <view class="tip-date">{{activityTip.date}}</view>
        <view class="tip-val">{{activityTip.value}}</view>
        <view wx:if="{{activityTip.extra}}" class="tip-sub">{{activityTip.extra}}</view>
      </view>
      <view wx:if="{{activityEmpty && !loading}}" class="mask">这段时间还没有{{activityMetric === 'ads' ? '曝光' : '日活'}}</view>
    </view>

    <view class="legend" wx:if="{{!activityEmpty}}">
      <view class="lg hint">{{activityHint}}</view>
    </view>
  </view>

  <view class="sheet sheet-next">
    <view class="sheet-head">
      <view>
        <view class="sheet-title">当前在线<text wx:if="{{refreshing}}" class="live"> 更新中</text></view>
        <view class="activity-kpis">
          <view class="activity-kpi">
            <text class="activity-k">此刻</text>
            <text class="activity-v">{{onlineNow}}<text class="activity-u"> 人</text></text>
          </view>
          <view class="activity-kpi" wx:if="{{onlinePeak}}">
            <text class="activity-k">峰值 {{onlinePeakAt}}</text>
            <text class="activity-v">{{onlinePeak}}<text class="activity-u"> 人</text></text>
          </view>
        </view>
        <view class="sheet-sum">全部游戏合计，近 24 小时，最右是此刻</view>
      </view>
    </view>

    <view class="chart-wrap" catchtap="onHold">
      <canvas
        type="2d"
        id="online"
        class="chart"
        bindtouchstart="onOnlineScrub"
        bindtouchmove="onOnlineScrub"
        bindtouchend="onOnlineScrub"
        bindtouchcancel="onOnlineScrub"
      ></canvas>
      <view wx:if="{{onlineTip.show}}" class="tip" style="left: {{onlineTip.left}}px; top: {{onlineTip.top}}px;">
        <view class="tip-date">{{onlineTip.date}}</view>
        <view class="tip-val">{{onlineTip.value}}</view>
      </view>
      <view wx:if="{{onlineEmpty && !loading}}" class="mask">近 24 小时还没有在线记录</view>
    </view>

    <view class="legend" wx:if="{{!onlineEmpty}}">
      <view class="lg hint">{{onlineHint}}</view>
    </view>
  </view>

  <view class="games-head">
    <text>游戏</text>
    <text class="games-count">{{gamesNote}}</text>
  </view>
  <view
    class="game"
    wx:for="{{games}}"
    wx:key="key"
    style="animation-delay: {{item.delay}}"
  >
    <view class="game-main">
      <image wx:if="{{item.icon}}" class="icon" src="{{item.icon}}" mode="aspectFill" data-key="{{item.key}}" binderror="onIconError" />
      <view wx:else class="icon mono">{{item.mark}}</view>
      <view class="game-copy">
        <view class="game-name-row">
          <text class="game-name">{{item.name}}</text>
          <text class="game-go" catchtap="onGame" data-key="{{item.key}}">大盘</text>
        </view>
        <view class="game-meta">{{item.meta}}</view>
      </view>
      <view class="game-side">
        <view class="game-rev">{{item.revenueText}}</view>
        <view class="game-rev-k">{{item.revLabel}}</view>
      </view>
    </view>
    <view catchtap="onHold">
      <spark
        values="{{item.spark}}"
        labels="{{labels}}"
        long-labels="{{longLabels}}"
        color="{{sparkColor}}"
        active="{{sparkKey === item.key ? sparkIndex : -1}}"
        data-key="{{item.key}}"
        bindscrub="onSpark"
      />
    </view>
    <view class="plats" wx:if="{{item.platforms.length}}">
      <view class="plat plat-head">
        <text class="plat-name">平台</text>
        <text>今日日活</text>
        <text>今日曝光</text>
        <text>{{item.revLabel}}</text>
      </view>
      <view class="plat plat-{{p.platform}}" wx:for="{{item.platforms}}" wx:for-item="p" wx:key="platform">
        <view class="plat-name">
          <view class="plat-dot"></view>
          <text>{{p.label}}</text>
        </view>
        <text class="plat-num">{{p.dau}}</text>
        <text class="plat-num">{{p.ads}}</text>
        <text class="plat-num plat-money">{{p.revenueText}}</text>
      </view>
    </view>
  </view>
</view>
