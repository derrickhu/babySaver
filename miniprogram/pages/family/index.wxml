<!-- 家庭管理页 -->
<view class="family-page">
  <!-- 已有家庭 -->
  <block wx:if="{{hasFamily && family}}">
    <view class="family-header card">
      <text class="family-icon">🏠</text>
      <text class="family-name">{{family.familyName}}</text>

      <!-- 邀请区域：仅管理员可见 -->
      <view class="invite-section" wx:if="{{isCreator}}">
        <text class="invite-label">邀请成员加入</text>
        <button class="share-btn" open-type="share">
          <text class="share-btn-icon">📤</text>
          <text class="share-btn-text">邀请到微信群</text>
          <text class="share-btn-desc">发到家庭群，成员打开即可加入</text>
        </button>
        <view class="invite-code-wrap" style="margin-top: 20rpx;">
          <text class="invite-code">{{inviteCode}}</text>
          <text class="copy-btn" bindtap="onCopyCode">复制</text>
        </view>
        <text class="invite-tip">也可复制邀请码，通过其他方式邀请</text>
      </view>

      <!-- 非管理员提示 -->
      <view class="non-creator-tip" wx:elif="{{isParent && !isCreator}}">
        <text class="tip-text">💡 如需邀请新成员，请联系家庭管理员邀请到微信群</text>
      </view>
    </view>

    <!-- 家庭成员 -->
    <view class="section-title">家庭成员</view>
    <view class="member-list card">
      <view class="member-item" wx:for="{{members}}" wx:key="_id">
        <view class="member-avatar-wrap">
          <image class="member-avatar-img" wx:if="{{item.avatarUrl && !item.avatarError}}" src="{{item.avatarUrl}}" mode="aspectFill" binderror="onMemberAvatarError" data-index="{{index}}"></image>
          <text class="member-avatar-emoji" wx:else>{{item.emoji}}</text>
        </view>
        <view class="member-info">
          <view class="member-name-row">
            <text class="member-name">{{item.nickName}}</text>
            <text class="creator-tag" wx:if="{{item.isCreator}}">管理员</text>
          </view>
          <text class="member-role">{{item.roleText}}</text>
        </view>
      </view>
      <view class="member-item empty-member" wx:if="{{members.length <= 1 && isCreator}}">
        <text class="member-avatar">➕</text>
        <view class="member-info">
          <text class="member-name" style="color: var(--text-hint);">等待成员加入...</text>
          <text class="member-role">邀请到家庭群即可加入</text>
        </view>
      </view>
    </view>

    <!-- 管理员：权限管理入口 -->
    <view class="perm-entry" wx:if="{{isCreator}}" bindtap="goPermissions">
      <text class="perm-entry-icon">🔐</text>
      <text class="perm-entry-text">权限管理</text>
      <text class="perm-entry-desc">管理家长的操作权限</text>
      <text class="perm-entry-arrow">›</text>
    </view>

    <!-- 管理员：转让管理员 -->
    <view class="perm-entry" wx:if="{{isCreator}}" bindtap="onTransferAdmin">
      <text class="perm-entry-icon">🔄</text>
      <text class="perm-entry-text">转让管理员</text>
      <text class="perm-entry-desc">将管理员身份转让给其他家长</text>
      <text class="perm-entry-arrow">›</text>
    </view>

    <!-- 开启消息通知（tap 事件中请求订阅） -->
    <view class="perm-entry" bindtap="onEnableNotify">
      <text class="perm-entry-icon">🔔</text>
      <text class="perm-entry-text">消息通知</text>
      <text class="perm-entry-desc">开启后可接收成员变动等通知</text>
      <text class="perm-entry-arrow">›</text>
    </view>

    <!-- 管理员：解散家庭 -->
    <view class="disband-entry" wx:if="{{isCreator}}" bindtap="onDisbandFamily">
      <text class="disband-icon">⚠️</text>
      <text class="disband-text">解散家庭</text>
      <text class="disband-desc">清除所有数据，不可恢复</text>
    </view>

    <!-- 非管理员：退出家庭 -->
    <view class="leave-entry" wx:if="{{!isCreator}}" bindtap="onLeaveFamily">
      <text class="leave-icon">🚪</text>
      <text class="leave-text">退出家庭</text>
      <text class="leave-desc">退出后需重新输入邀请码加入</text>
    </view>
  </block>

  <!-- 未创建/加入家庭 -->
  <block wx:elif="{{!loading}}">
    <!-- 家长 - 创建家庭或加入家庭 -->
    <block wx:if="{{isParent}}">
      <view class="setup-card card">
        <text class="setup-icon">🏠</text>
        <text class="setup-title">创建您的家庭</text>
        <text class="setup-desc">创建后，将生成邀请码\n小孩和其他家长输入邀请码即可加入</text>
        <button class="btn-primary" style="width: 100%; margin-top: 40rpx;" bindtap="onCreateFamily">创建家庭</button>
      </view>

      <!-- 家长也可以加入已有家庭 -->
      <view class="setup-card card" style="margin-top: 0;">
        <text class="setup-icon">🔗</text>
        <text class="setup-title">加入已有家庭</text>
        <text class="setup-desc">如果其他家长已创建家庭，输入邀请码即可加入</text>
        <view class="code-input-wrap">
          <input
            class="code-input"
            placeholder="请输入6位邀请码"
            value="{{inputCode}}"
            bindinput="onCodeInput"
            maxlength="6"
          />
        </view>
        <button class="btn-secondary" style="width: 100%; margin-top: 32rpx;" bindtap="onJoinFamily">加入家庭</button>
      </view>
    </block>

    <!-- 小孩 - 加入家庭 -->
    <block wx:else>
      <view class="setup-card card">
        <text class="setup-icon">🔗</text>
        <text class="setup-title">加入家庭</text>
        <text class="setup-desc">输入家长分享的邀请码加入家庭</text>
        <view class="code-input-wrap">
          <input
            class="code-input"
            placeholder="请输入6位邀请码"
            value="{{inputCode}}"
            bindinput="onCodeInput"
            maxlength="6"
          />
        </view>
        <button class="btn-primary" style="width: 100%; margin-top: 32rpx;" bindtap="onJoinFamily">加入家庭</button>
      </view>
    </block>
  </block>
</view>
