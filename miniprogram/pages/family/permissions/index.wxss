/* 权限管理页 */
.page-container {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx;
}
.loading-wrap {
  display: flex; justify-content: center; padding-top: 200rpx;
}
.loading-text { font-size: 26rpx; color: #999; }

.page-tip {
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.page-tip text {
  font-size: 24rpx;
  color: #996600;
  line-height: 1.6;
}

/* 家长卡片 */
.parent-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}
.parent-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.parent-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.parent-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}
.parent-avatar-text {
  font-size: 40rpx;
}
.parent-info {
  flex: 1;
}
.parent-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}
.parent-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.creator-tag {
  font-size: 20rpx;
  color: #ff9800;
  border: 1rpx solid #ff9800;
  border-radius: 4rpx;
  padding: 2rpx 10rpx;
}
.parent-title {
  font-size: 24rpx;
  color: #999;
}

/* 权限开关 */
.perm-list {}
.perm-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}
.perm-label {
  font-size: 28rpx;
  color: #333;
}

/* 自定义开关 */
.perm-switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 48rpx;
  background: #e0e0e0;
  position: relative;
  transition: background 0.3s;
}
.perm-switch.on {
  background: #07c160;
}
.perm-switch.disabled {
  opacity: 0.6;
}
.switch-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: transform 0.3s;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}
.perm-switch.on .switch-dot {
  transform: translateX(40rpx);
}

.perm-note {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
}
.perm-note text {
  font-size: 22rpx;
  color: #bbb;
}

.empty-state {
  padding-top: 120rpx;
  text-align: center;
}
.empty-text {
  font-size: 26rpx;
  color: #999;
  line-height: 1.8;
}
