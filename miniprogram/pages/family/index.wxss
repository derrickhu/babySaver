/* 家庭管理页样式 */
.family-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.family-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 36rpx;
  margin: 24rpx;
}

.family-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.family-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.invite-section {
  width: 100%;
  text-align: center;
}

.invite-label {
  font-size: 24rpx;
  color: var(--text-hint);
  display: block;
  margin-bottom: 12rpx;
}

.invite-code-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.invite-code {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 8rpx;
}

.copy-btn {
  font-size: 24rpx;
  color: #fff;
  background: var(--primary);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.invite-tip {
  font-size: 22rpx;
  color: var(--text-hint);
}

.section-title {
  padding: 24rpx 32rpx 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.member-list {
  margin: 16rpx 24rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.member-info {
  flex: 1;
}

.member-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
}

.member-role {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

/* 设置卡片 */
.setup-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 80rpx 32rpx 0;
  padding: 64rpx 48rpx;
}

.setup-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.setup-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.setup-desc {
  font-size: 26rpx;
  color: var(--text-hint);
  text-align: center;
  line-height: 1.8;
}

.code-input-wrap {
  width: 100%;
  margin-top: 32rpx;
}

.code-input {
  height: 96rpx;
  background: var(--bg-page);
  border-radius: 16rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 12rpx;
}
