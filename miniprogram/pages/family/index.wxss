/* 家庭管理页样式 */
.family-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.family-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 36rpx;
  margin: 24rpx;
}

.family-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.family-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.invite-section {
  width: 100%;
  text-align: center;
}

.invite-label {
  font-size: 24rpx;
  color: var(--text-hint);
  display: block;
  margin-bottom: 12rpx;
}

.invite-code-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.invite-code {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 8rpx;
}

.copy-btn {
  font-size: 24rpx;
  color: #fff;
  background: var(--primary);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.invite-tip {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 分享到微信群按钮 */
.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 32rpx 24rpx;
  margin-top: 16rpx;
  background: linear-gradient(135deg, #5B8FF9 0%, #7B68EE 100%);
  border-radius: 16rpx;
  color: #fff;
  border: none;
}

.share-btn::after {
  border: none;
}

.share-btn-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.share-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.share-btn-desc {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 非创建者提示 */
.non-creator-tip {
  width: 100%;
  text-align: center;
  padding: 20rpx 24rpx;
  background: var(--bg-page);
  border-radius: 12rpx;
}

.tip-text {
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.6;
}

.section-title {
  padding: 24rpx 32rpx 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.member-list {
  margin: 16rpx 24rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.member-avatar-img {
  width: 72rpx;
  height: 72rpx;
  display: block;
}
.member-avatar-emoji {
  font-size: 36rpx;
}

.member-info {
  flex: 1;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.member-name {
  font-size: 30rpx;
  font-weight: 500;
}

.creator-tag {
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}


.member-role {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

/* 设置卡片 */
.setup-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 80rpx 32rpx 24rpx;
  padding: 64rpx 48rpx;
}

.setup-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.setup-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.setup-desc {
  font-size: 26rpx;
  color: var(--text-hint);
  text-align: center;
  line-height: 1.8;
}

.code-input-wrap {
  width: 100%;
  margin-top: 32rpx;
}

.code-input {
  height: 96rpx;
  background: var(--bg-page);
  border-radius: 16rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 12rpx;
}

/* 权限管理入口 */
.perm-entry {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}
.perm-entry-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}
.perm-entry-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}
.perm-entry-desc {
  flex: 1;
  font-size: 24rpx;
  color: #999;
  text-align: right;
  margin-right: 8rpx;
}
.perm-entry-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 解散家庭入口 */
.disband-entry {
  display: flex;
  align-items: center;
  margin: 16rpx 32rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #FFF1F0;
  border: 1rpx solid #FFccc7;
}
.disband-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}
.disband-text {
  font-size: 28rpx;
  color: var(--danger);
  font-weight: 500;
}
.disband-desc {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-hint);
  text-align: right;
}

/* 退出家庭入口 */
.leave-entry {
  display: flex;
  align-items: center;
  margin: 16rpx 32rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--bg-page);
  border: 1rpx solid var(--border);
}
.leave-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}
.leave-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}
.leave-desc {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-hint);
  text-align: right;
}
