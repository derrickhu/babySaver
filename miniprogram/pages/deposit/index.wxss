/* 存入页 */
.page-container {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx;
}
.loading-wrap {
  display: flex; justify-content: center; padding-top: 200rpx;
}
.loading-text { font-size: 26rpx; color: #999; }
.empty-state {
  display: flex; flex-direction: column; align-items: center; padding-top: 200rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #999; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 28rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.form-item:last-child { border-bottom: none; }
.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}
.form-picker {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}
.picker-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 8rpx;
}
.account-balance {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}
.balance-label { font-size: 24rpx; color: #999; }
.balance-value { font-size: 28rpx; color: #4a7cf7; font-weight: 600; }
.amount-card { padding: 40rpx 28rpx; }
.amount-input-wrap {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #f0f0f0;
  padding-bottom: 16rpx;
}
.amount-prefix {
  font-size: 52rpx;
  font-weight: 700;
  color: #333;
  margin-right: 12rpx;
}
.amount-input {
  flex: 1;
  font-size: 52rpx;
  font-weight: 700;
  color: #333;
}
.btn-submit {
  margin-top: 48rpx;
  background: linear-gradient(135deg, #4a7cf7, #6c5ce7);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-submit[disabled] { opacity: 0.5; }
