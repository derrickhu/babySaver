<!-- 存入页（家长 → 小孩默认账户） -->
<view class="page-container">
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="empty-state" wx:elif="{{children.length === 0}}">
    <text class="empty-icon">🧒</text>
    <text class="empty-text">还没有小孩加入家庭</text>
  </view>

  <block wx:else>
    <!-- 选择小孩 -->
    <view class="card">
      <view class="form-item">
        <text class="form-label">转入账户</text>
        <picker bindchange="onChildChange" value="{{selectedChildIndex}}" range="{{children}}" range-key="nickName">
          <view class="form-picker">
            <text>🧒 {{childName}} 的默认账户</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="account-balance">
        <text class="balance-label">当前余额</text>
        <text class="balance-value">¥{{accountBalance}}</text>
      </view>
    </view>

    <!-- 输入金额 -->
    <view class="card amount-card">
      <view class="amount-input-wrap">
        <text class="amount-prefix">¥</text>
        <input class="amount-input" type="digit" placeholder="输入存入金额" value="{{amount}}" bindinput="onAmountInput" />
      </view>
    </view>

    <!-- 备注 -->
    <view class="card">
      <view class="form-item">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="请填写备注（必填）" value="{{remark}}" bindinput="onRemarkInput" maxlength="50" />
      </view>
    </view>

    <button class="btn-submit" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '处理中...' : '确认存入'}}
    </button>
  </block>
</view>
