<!-- 账单明细页 -->
<view class="page-container">
  <!-- 筛选区 -->
  <view class="filter-section">
    <!-- 第一行：小孩 + 时间 -->
    <view class="filter-row">
      <view class="child-filter-btn" wx:if="{{isParent && children.length > 0}}" bindtap="showChildPicker">
        <text wx:if="{{!selectedChildId}}">全部小孩</text>
        <text wx:else>🧒 {{selectedChildName}}</text>
        <text class="filter-arrow">▼</text>
      </view>
      <view class="pill-group">
        <view
          class="pill {{activeTime === item.key ? 'pill-on' : ''}}"
          wx:for="{{timeShortcuts}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onTimeShortcut"
        >{{item.label}}</view>
      </view>
    </view>

    <!-- 自定义时间 -->
    <view class="custom-time-row" wx:if="{{showCustomTime}}">
      <picker mode="date" value="{{startDate}}" end="{{todayStr}}" bindchange="onStartDateChange">
        <view class="date-btn">{{startDate || '开始日期'}}</view>
      </picker>
      <text class="date-sep">—</text>
      <picker mode="date" value="{{endDate}}" start="{{startDate}}" end="{{todayStr}}" bindchange="onEndDateChange">
        <view class="date-btn">{{endDate || '结束日期'}}</view>
      </picker>
    </view>

    <!-- 类型过滤 -->
    <view class="filter-row">
      <view class="pill-group">
        <view
          class="pill {{activeFilter === item.key ? 'pill-on' : ''}}"
          wx:for="{{filters}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onFilterChange"
        >{{item.label}}</view>
      </view>
    </view>

    <!-- 标签筛选：仅选 收入/支出 时展示对应标签 -->
    <view class="tag-section" wx:if="{{activeFilter === 'deposit'}}">
      <text class="tag-section-label">来源</text>
      <scroll-view class="tag-scroll" scroll-x enable-flex>
        <view
          class="pill pill-sm {{activeTag === item.key ? 'pill-on' : ''}}"
          wx:for="{{depositTags}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onTagFilter"
        >{{item.label}}</view>
      </scroll-view>
    </view>

    <view class="tag-section" wx:if="{{activeFilter === 'withdraw'}}">
      <text class="tag-section-label">用途</text>
      <scroll-view class="tag-scroll" scroll-x enable-flex>
        <view
          class="pill pill-sm {{activeTag === item.key ? 'pill-on' : ''}}"
          wx:for="{{withdrawTags}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onTagFilter"
        >{{item.label}}</view>
      </scroll-view>
    </view>
  </view>

  <!-- 收支汇总 -->
  <view class="summary-card" wx:if="{{summary}}">
    <view class="summary-col">
      <text class="summary-num income">+{{summary.totalIncome}}</text>
      <text class="summary-label">收入</text>
    </view>
    <view class="summary-line"></view>
    <view class="summary-col">
      <text class="summary-num expense">-{{summary.totalExpense}}</text>
      <text class="summary-label">支出</text>
    </view>
    <view class="summary-line"></view>
    <view class="summary-col">
      <text class="summary-num net">{{summary.net}}</text>
      <text class="summary-label">结余</text>
    </view>
    <text class="summary-count">{{summary.txCount}}笔</text>
  </view>

  <!-- 账单列表 -->
  <view class="tx-list">
    <view class="tx-item" wx:for="{{transactions}}" wx:key="_id">
      <view class="tx-icon-wrap">
        <text class="tx-icon">{{item.typeIcon}}</text>
      </view>
      <view class="tx-info">
        <view class="tx-type-row">
          <text class="tx-type">{{item.typeText}}</text>
          <text class="tx-tag" wx:if="{{item.tagLabel}}">{{item.tagLabel}}</text>
        </view>
        <text class="tx-detail" wx:if="{{item.relatedName || item.showChildName}}">{{item.relatedName || ''}}{{item.showChildName ? ' · ' + item.childName : ''}}</text>
        <text class="tx-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
        <text class="tx-time">{{item.timeStr}}</text>
      </view>
      <view class="tx-right">
        <text class="tx-amount {{item.isIncome ? 'income' : 'expense'}}">
          {{item.isIncome ? '+' : '-'}}{{item.amountStr}}
        </text>
        <text class="tx-status tx-status-{{item.status}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && transactions.length === 0}}">
    <text class="empty-icon">📄</text>
    <text class="empty-text">暂无账单记录</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{loading && transactions.length > 0}}">
    <text>加载中...</text>
  </view>
  <view class="load-more" wx:if="{{!hasMore && transactions.length > 0}}">
    <text>— 没有更多了 —</text>
  </view>

  <!-- 首次加载 -->
  <view class="loading-wrap" wx:if="{{loading && transactions.length === 0}}">
    <text class="loading-text">加载中...</text>
  </view>
</view>
