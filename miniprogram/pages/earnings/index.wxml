<!-- 账单明细页 -->
<view class="page-container">
  <!-- 家长：小孩筛选 -->
  <view class="child-filter" wx:if="{{isParent && children.length > 0}}">
    <view class="child-filter-btn" bindtap="showChildPicker">
      <text wx:if="{{!selectedChildId}}">全部小孩</text>
      <text wx:else>🧒 {{selectedChildName}}</text>
      <text class="filter-arrow">▼</text>
    </view>
  </view>

  <!-- 类型过滤 -->
  <view class="filter-bar">
    <view
      class="filter-item {{activeFilter === item.key ? 'active' : ''}}"
      wx:for="{{filters}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onFilterChange"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- 账单列表 -->
  <view class="tx-list">
    <view class="tx-item" wx:for="{{transactions}}" wx:key="_id">
      <view class="tx-icon-wrap">
        <text class="tx-icon">{{item.typeIcon}}</text>
      </view>
      <view class="tx-info">
        <text class="tx-type">{{item.typeText}}</text>
        <text class="tx-detail">{{item.relatedName || ''}}{{item.showChildName ? ' · ' + item.childName : ''}}</text>
        <text class="tx-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
        <text class="tx-time">{{item.timeStr}}</text>
      </view>
      <view class="tx-right">
        <text class="tx-amount {{item.isIncome ? 'income' : 'expense'}}">
          {{item.isIncome ? '+' : '-'}}¥{{item.amountStr}}
        </text>
        <text class="tx-status tx-status-{{item.status}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && transactions.length === 0}}">
    <text class="empty-icon">📄</text>
    <text class="empty-text">暂无账单记录</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{loading && transactions.length > 0}}">
    <text>加载中...</text>
  </view>
  <view class="load-more" wx:if="{{!hasMore && transactions.length > 0}}">
    <text>没有更多了</text>
  </view>

  <!-- 首次加载 -->
  <view class="loading-wrap" wx:if="{{loading && transactions.length === 0}}">
    <text class="loading-text">加载中...</text>
  </view>
</view>
