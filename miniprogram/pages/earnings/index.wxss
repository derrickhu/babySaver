/* 账单明细页 */
.page-container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 120rpx;
}

/* 小孩筛选 */
.child-filter {
  padding: 20rpx 24rpx 0;
}
.child-filter-btn {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #333;
}
.filter-arrow {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 类型过滤 */
.filter-bar {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  overflow-x: auto;
}
.filter-item {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
}
.filter-item.active {
  background: #4a7cf7;
  color: #fff;
  font-weight: 500;
}

/* 账单列表 */
.tx-list {
  padding: 0 24rpx;
}
.tx-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.tx-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #f5f7ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.tx-icon { font-size: 32rpx; }
.tx-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.tx-type-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.tx-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.tx-tag {
  font-size: 20rpx;
  color: #4a7cf7;
  background: rgba(74, 124, 247, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}
.tx-detail {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.tx-remark {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tx-time {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}
.tx-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.tx-amount {
  font-size: 30rpx;
  font-weight: 700;
  font-family: 'DIN', 'Helvetica Neue', sans-serif;
}
.tx-amount.income { color: #07c160; }
.tx-amount.expense { color: #ff4d4f; }
.tx-status {
  display: block;
  font-size: 20rpx;
  margin-top: 4rpx;
}
.tx-status-success { color: #07c160; }
.tx-status-pending { color: #ff9800; }
.tx-status-approved { color: #07c160; }
.tx-status-rejected { color: #ff4d4f; }

/* 空/加载 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #999; }
.loading-wrap {
  display: flex; justify-content: center; padding-top: 200rpx;
}
.loading-text { font-size: 26rpx; color: #999; }
.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #bbb;
}
