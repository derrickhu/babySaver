<!-- 收益日历（参考微众银行） -->
<view class="page-container">
  <!-- 家长选择小孩 -->
  <view class="child-bar" wx:if="{{isParent && children.length > 0}}">
    <picker bindchange="onChildChange" value="{{selectedChildIndex}}" range="{{children}}" range-key="nickName">
      <view class="child-bar-inner">
        <text>🧒 {{children[selectedChildIndex].nickName}} 的收益</text>
        <text class="child-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 日收益 -->
  <view class="earning-header">
    <view class="earning-header-left">
      <text class="earning-header-label">日收益</text>
    </view>
    <text class="earning-header-value">{{todayEarning}}</text>
  </view>

  <!-- 月份导航 + 日历 -->
  <view class="calendar-card">
    <view class="month-nav">
      <view class="nav-btn" bindtap="onPrevMonth">◀</view>
      <text class="month-text">{{currentYear}}年{{currentMonth}}月</text>
      <view class="nav-btn" bindtap="onNextMonth">▶</view>
    </view>

    <!-- 星期头 -->
    <view class="weekday-row">
      <view class="weekday-cell" wx:for="{{weekDays}}" wx:key="*this">{{item}}</view>
    </view>

    <!-- 日历网格 -->
    <view class="calendar-week" wx:for="{{calendarWeeks}}" wx:key="index">
      <view
        class="calendar-day {{day.date === selectedDate ? 'selected' : ''}} {{day.hasEarning ? 'has-earning' : ''}} {{day.day === 0 ? 'empty' : ''}}"
        wx:for="{{item}}"
        wx:for-item="day"
        wx:key="date"
        data-date="{{day.date}}"
        bindtap="onDateTap"
      >
        <text class="day-num" wx:if="{{day.day > 0}}">{{day.day}}</text>
        <text class="day-earning {{day.earning < 0 ? 'negative' : ''}}" wx:if="{{day.hasEarning}}">{{day.earningStr}}</text>
      </view>
    </view>
  </view>

  <!-- 月度统计 -->
  <view class="month-summary">
    <text class="month-summary-label">本月累计收益</text>
    <text class="month-summary-value">+¥{{monthTotal}}</text>
  </view>

  <!-- 选中日期详情 -->
  <view class="detail-card" wx:if="{{selectedDetail}}">
    <text class="detail-date">收益构成  {{selectedDate}}</text>
    <view class="detail-list">
      <view class="detail-item" wx:for="{{selectedDetail.details}}" wx:key="index">
        <view class="detail-item-left">
          <text class="detail-source">{{item.productName}}</text>
          <text class="detail-meta">余额 ¥{{item.balance}} · {{item.rate}}%</text>
        </view>
        <text class="detail-earning">+{{item.dailyEarning}}</text>
      </view>
    </view>
  </view>

  <view class="detail-card" wx:elif="{{selectedDate}}" style="text-align: center; padding: 32rpx;">
    <text style="color: #999; font-size: 26rpx;">{{selectedDate}} 暂无收益记录</text>
  </view>
</view>
