/* 收益日历 - 微众银行风格 */
.page-container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 40rpx;
}

/* 小孩选择 */
.child-bar {
  padding: 20rpx 24rpx;
  background: #fff;
}
.child-bar-inner {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}
.child-arrow {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 日收益 */
.earning-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  background: #fff;
}
.earning-header-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.earning-header-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #ff4d4f;
  font-family: 'DIN', 'Helvetica Neue', sans-serif;
}

/* 日历卡 */
.calendar-card {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
}
.month-text {
  font-size: 30rpx;
  font-weight: 600;
  margin: 0 32rpx;
  color: #333;
}

/* 星期头 */
.weekday-row {
  display: flex;
}
.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 12rpx 0;
}

/* 日历行 */
.calendar-week {
  display: flex;
}
.calendar-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 2rpx;
  min-height: 88rpx;
  border-radius: 8rpx;
}
.calendar-day.empty { visibility: hidden; }
.calendar-day.selected {
  background: #fff0f0;
  border-radius: 12rpx;
}
.calendar-day.has-earning .day-num {
  color: #333;
  font-weight: 600;
}
.day-num {
  font-size: 28rpx;
  color: #666;
}
.day-earning {
  font-size: 18rpx;
  color: #ff4d4f;
  margin-top: 2rpx;
  white-space: nowrap;
}
.day-earning.negative {
  color: #07c160;
}

/* 月度统计 */
.month-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 24rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
}
.month-summary-label {
  font-size: 28rpx;
  color: #333;
}
.month-summary-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff4d4f;
}

/* 详情卡 */
.detail-card {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}
.detail-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}
.detail-list {}
.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.detail-item:last-child { border-bottom: none; }
.detail-item-left {
  display: flex;
  flex-direction: column;
}
.detail-source {
  font-size: 28rpx;
  color: #333;
}
.detail-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.detail-earning {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff4d4f;
}
