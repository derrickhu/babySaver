<!-- 理财产品管理 -->
<view class="page-container">
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 产品列表 -->
    <view class="product-list">
      <view
        class="product-card"
        wx:for="{{products}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="goDetail"
      >
        <view class="product-top">
          <view class="product-name-row">
            <text class="product-name">{{item.name}}</text>
            <text class="risk-tag" style="color: {{item.riskColor}}; border-color: {{item.riskColor}};">{{item.riskLabel}}</text>
            <text class="offline-tag" wx:if="{{item.status === 'inactive'}}">已下线</text>
          </view>
          <text class="product-desc" wx:if="{{item.description}}">{{item.description}}</text>
        </view>
        <view class="product-stats">
          <view class="stat-item">
            <text class="stat-value">{{item.rateStr}}</text>
            <text class="stat-label">年化收益率</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{item.typeLabel}}</text>
            <text class="stat-label">产品类型</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{item.dailyPer1000}}</text>
            <text class="stat-label">每千元日收益</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 变更记录入口（家长） -->
    <view class="logs-entry" bindtap="goAllLogs" wx:if="{{isParent}}">
      <text class="logs-icon">📋</text>
      <text class="logs-text">产品变更记录</text>
      <text class="logs-arrow">›</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{products.length === 0}}">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无理财产品</text>
      <text class="empty-text" wx:if="{{isParent}}">点击下方按钮创建</text>
    </view>

    <!-- 家长创建按钮 -->
    <view class="fab-btn" bindtap="goCreate" wx:if="{{isParent}}">
      <text class="fab-icon">+</text>
    </view>
  </block>
</view>
