/* 理财产品管理 */
.page-container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 160rpx;
}
.loading-wrap {
  display: flex; justify-content: center; padding-top: 200rpx;
}
.loading-text { font-size: 26rpx; color: #999; }

.product-list { padding: 24rpx; }
.product-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}
.product-top {
  margin-bottom: 20rpx;
}
.product-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}
.risk-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border: 1rpx solid;
  border-radius: 4rpx;
}
.product-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}
.product-stats {
  display: flex;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff6b35;
}
.stat-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #999; line-height: 1.6; }

/* FAB */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4a7cf7, #6c5ce7);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 124, 247, 0.4);
}
.fab-icon {
  font-size: 52rpx;
  color: #fff;
  font-weight: 300;
}
