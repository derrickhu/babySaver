<!-- 产品详情 -->
<view class="page-container">
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:elif="{{product}}">
    <!-- 产品信息卡 -->
    <view class="info-card">
      <view class="info-header">
        <text class="info-name">{{product.name}}</text>
        <text class="risk-tag" style="color:{{product.riskColor}};border-color:{{product.riskColor}};">{{product.riskLabel}}</text>
      </view>
      <view class="rate-row">
        <text class="rate-value">{{product.rateStr}}</text>
        <text class="rate-label">年化收益率</text>
      </view>
      <view class="info-detail-row">
        <view class="info-detail-item">
          <text class="info-detail-label">类型</text>
          <text class="info-detail-value">{{product.typeLabel}}</text>
        </view>
        <view class="info-detail-item">
          <text class="info-detail-label">起购</text>
          <text class="info-detail-value">¥{{product.minAmount || 0}}</text>
        </view>
        <view class="info-detail-item" wx:if="{{product.type === 'fixed'}}">
          <text class="info-detail-label">期限</text>
          <text class="info-detail-value">{{product.termDays}}天</text>
        </view>
      </view>
      <view class="info-desc" wx:if="{{product.description}}">
        <text>{{product.description}}</text>
      </view>
    </view>

    <!-- 我的持仓（小孩有投资时显示） -->
    <view class="holding-card" wx:if="{{investment}}">
      <text class="section-title">我的持仓</text>
      <view class="holding-row">
        <view class="holding-item">
          <text class="holding-value">¥{{investment.totalValueStr}}</text>
          <text class="holding-label">持有金额</text>
        </view>
        <view class="holding-item">
          <text class="holding-value holding-earnings">+¥{{investment.earningsStr}}</text>
          <text class="holding-label">累计收益</text>
        </view>
      </view>
      <view class="holding-meta">
        <text>买入日期：{{investment.startDate}}</text>
        <text wx:if="{{investment.endDate}}">到期日期：{{investment.endDate}}</text>
      </view>
      <view class="holding-status" wx:if="{{investment.status === 'matured'}}">
        <text class="matured-badge">已到期，可赎回</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <!-- 家长：编辑/停售 -->
      <block wx:if="{{isParent}}">
        <button class="btn-outline" bindtap="goEdit">编辑产品</button>
        <button class="btn-warn" bindtap="toggleStatus">
          {{product.status === 'active' ? '停售' : '上架'}}
        </button>
      </block>
      <!-- 小孩：买入/赎回 -->
      <block wx:if="{{isChild}}">
        <button class="btn-primary" bindtap="openBuyModal" wx:if="{{product.status === 'active'}}">
          买入
        </button>
        <button class="btn-outline" bindtap="openRedeemModal" wx:if="{{investment && investment.canRedeem}}">
          赎回
        </button>
      </block>
    </view>
  </block>

  <!-- 买入弹窗 -->
  <view class="modal-mask" wx:if="{{showBuyModal}}" bindtap="closeBuyModal">
    <view class="modal-content" catchtap="">
      <text class="modal-title">买入 {{product.name}}</text>
      <text class="modal-tip">可用余额：¥{{accountBalanceStr}}</text>
      <view class="modal-input-wrap">
        <text class="modal-input-prefix">¥</text>
        <input class="modal-input" type="digit" placeholder="输入买入金额" value="{{buyAmount}}" bindinput="onBuyAmountInput" focus="{{showBuyModal}}" />
      </view>
      <input class="modal-remark" placeholder="请填写备注（必填）" value="{{buyRemark}}" bindinput="onBuyRemarkInput" maxlength="50" />
      <button class="modal-btn" bindtap="onBuy">确认买入</button>
    </view>
  </view>

  <!-- 赎回弹窗 -->
  <view class="modal-mask" wx:if="{{showRedeemModal}}" bindtap="closeRedeemModal">
    <view class="modal-content" catchtap="">
      <text class="modal-title">赎回 {{product.name}}</text>
      <text class="modal-tip">将赎回 ¥{{investment.totalValueStr}}（本金+收益）到默认账户</text>
      <input class="modal-remark" placeholder="请填写备注（必填）" value="{{redeemRemark}}" bindinput="onRedeemRemarkInput" maxlength="50" />
      <button class="modal-btn" bindtap="onRedeem">确认赎回</button>
    </view>
  </view>
</view>
