/* 产品详情 */
.page-container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 200rpx;
}
.loading-wrap {
  display: flex; justify-content: center; padding-top: 200rpx;
}
.loading-text { font-size: 26rpx; color: #999; }

/* 产品信息卡 */
.info-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
}
.info-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.info-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-right: 16rpx;
}
.risk-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border: 1rpx solid;
  border-radius: 6rpx;
}
.rate-row {
  margin-bottom: 24rpx;
}
.rate-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #ff6b35;
  font-family: 'DIN', 'Helvetica Neue', sans-serif;
}
.rate-label {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
}
.info-detail-row {
  display: flex;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}
.info-detail-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.info-detail-label {
  font-size: 22rpx;
  color: #999;
}
.info-detail-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-top: 4rpx;
}
.info-desc {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #f8f9fb;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* 持仓卡 */
.holding-card {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}
.holding-row {
  display: flex;
}
.holding-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.holding-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}
.holding-earnings { color: #07c160; }
.holding-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.holding-meta {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #bbb;
  display: flex;
  gap: 32rpx;
}
.holding-status { margin-top: 12rpx; }
.matured-badge {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
}

/* 操作按钮 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0; right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #4a7cf7, #6c5ce7);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-outline {
  flex: 1;
  background: #fff;
  color: #4a7cf7;
  border: 2rpx solid #4a7cf7;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.btn-warn {
  flex: 1;
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}
.modal-tip {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 32rpx;
}
.modal-input-wrap {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}
.modal-input-prefix {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  margin-right: 12rpx;
}
.modal-input {
  flex: 1;
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
}
.modal-remark {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 32rpx;
}
.modal-estimate {
  padding: 16rpx 0 24rpx;
}
.modal-estimate-text {
  font-size: 24rpx;
  color: #07c160;
}
.modal-btn {
  background: linear-gradient(135deg, #4a7cf7, #6c5ce7);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.holding-daily { color: #ff6b35; }
.matured-badge {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
}
