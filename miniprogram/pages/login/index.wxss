/* 登录注册页 */
.login-page {
  min-height: 100vh;
  background: #fff;
}

/* ===== Step 1 欢迎屏 ===== */
.welcome {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.welcome-top {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.logo-box {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #5B8FF9 0%, #7B68EE 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(91, 143, 249, 0.35);
}

.logo-icon {
  font-size: 80rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #999;
}

.welcome-bottom {
  padding: 0 48rpx 80rpx;
}

/* 微信登录按钮 */
.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: #07C160;
  border-radius: 48rpx;
  border: none;
  margin-bottom: 24rpx;
}

.wx-login-btn::after {
  border: none;
}

.wx-login-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* 协议行 */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  padding: 16rpx 0;
}

.agreement-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  font-size: 20rpx;
  color: #fff;
  transition: all 0.2s;
}

.agreement-check.checked {
  background: #07C160;
  border-color: #07C160;
}

.agreement-text {
  font-size: 24rpx;
  color: #999;
}

.agreement-link {
  font-size: 24rpx;
  color: #5B8FF9;
}

/* ===== Step 2 完善资料 ===== */
.profile-setup {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
}

.setup-nav {
  padding: 24rpx 32rpx 0;
}

.setup-back {
  font-size: 32rpx;
  color: #5B8FF9;
  font-weight: 500;
}

.setup-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  padding: 32rpx 36rpx 8rpx;
}

.setup-subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
  padding: 0 36rpx 32rpx;
}

.setup-card {
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
}

.card-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 头像行 */
.avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  background: none;
  border: none;
  padding: 12rpx 0 24rpx;
  margin: 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.avatar-row::after {
  display: none;
}

.avatar-box {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f0f0;
  margin-bottom: 12rpx;
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  display: block;
}

.avatar-placeholder {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.avatar-change {
  font-size: 24rpx;
  color: #5B8FF9;
}

/* 昵称行 */
.nickname-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0 8rpx;
}

.nickname-label {
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.nickname-input {
  flex: 1;
  height: 64rpx;
  font-size: 30rpx;
  color: #333;
  text-align: right;
}

/* 角色选择 */
.role-picker {
  display: flex;
  gap: 20rpx;
}

.role-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid #eee;
  background: #FAFAFA;
  transition: all 0.25s;
}

.role-card.active {
  border-color: #5B8FF9;
  background: #EBF2FF;
}

.role-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.role-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.role-card.active .role-name {
  color: #5B8FF9;
}

.role-desc {
  font-size: 22rpx;
  color: #999;
}

/* 家长身份选择 */
.title-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.title-chip {
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  border: 2rpx solid #eee;
  background: #FAFAFA;
  font-size: 28rpx;
  color: #666;
  transition: all 0.25s;
}

.title-chip.active {
  border-color: #5B8FF9;
  background: #EBF2FF;
  color: #5B8FF9;
  font-weight: 600;
}

/* 提交按钮 */
.submit-btn {
  margin: 24rpx 24rpx 0;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #5B8FF9 0%, #7B68EE 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #ccc;
  color: #fff;
}
