/* 登录注册页样式 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #5B8FF9 0%, #E8F0FE 50%, #F5F7FA 100%);
  padding-bottom: 60rpx;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 60rpx;
}

.logo-wrapper {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(91, 143, 249, 0.3);
  margin-bottom: 24rpx;
}

.logo-icon {
  font-size: 80rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.login-form {
  margin: 0 32rpx;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 40rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 36rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  height: 88rpx;
  background: var(--bg-page);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.role-selector {
  display: flex;
  gap: 24rpx;
}

.role-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  transition: all 0.3s;
}

.role-option.active {
  border-color: var(--primary);
  background: var(--primary-light);
}

.role-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.role-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.role-desc {
  font-size: 22rpx;
  color: var(--text-hint);
}

.role-option.active .role-name {
  color: var(--primary);
}

.register-btn {
  margin-top: 48rpx;
}
