/* 注册页面 */
.login-page {
  min-height: 100vh;
  background: #F5F7FA;
  overflow: hidden;
}

/* 分步页面切换 */
.step-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}
.step-active {
  animation: stepFadeIn 0.3s ease;
}
@keyframes stepFadeIn {
  from { opacity: 0; transform: translateX(40rpx); }
  to { opacity: 1; transform: translateX(0); }
}

/* Step 2 顶部栏 */
.step2-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}
.step2-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.step2-back-icon {
  font-size: 44rpx;
  color: #333;
  line-height: 1;
  margin-top: -4rpx;
}
.step2-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.step2-placeholder {
  width: 64rpx;
}

/* 顶部 Logo */
.reg-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 48rpx;
}
.reg-logo-box {
  width: 128rpx;
  height: 128rpx;
  background: linear-gradient(135deg, #5B8FF9 0%, #7B68EE 100%);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(91, 143, 249, 0.3);
}
.reg-logo-icon {
  font-size: 64rpx;
}
.reg-app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}
.reg-subtitle {
  font-size: 28rpx;
  color: #999;
}

.setup-card {
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
}

.card-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 角色选择 */
.role-picker {
  display: flex;
  gap: 20rpx;
}

.role-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid #eee;
  background: #FAFAFA;
  transition: all 0.25s;
}

.role-card.active {
  border-color: #5B8FF9;
  background: #EBF2FF;
  box-shadow: 0 4rpx 16rpx rgba(91, 143, 249, 0.15);
}

.role-emoji {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.role-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.role-card.active .role-name {
  color: #5B8FF9;
}

.role-desc {
  font-size: 24rpx;
  color: #999;
}

/* 家长身份选择 */
.title-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.title-chip {
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  border: 2rpx solid #eee;
  background: #FAFAFA;
  font-size: 28rpx;
  color: #666;
  transition: all 0.25s;
}

.title-chip.active {
  border-color: #5B8FF9;
  background: #EBF2FF;
  color: #5B8FF9;
  font-weight: 600;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  align-items: center;
  padding: 12rpx 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.avatar-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
}

.default-avatar-circle {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8F0FE 0%, #D6E4FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #B4D0FF;
}

.default-avatar-emoji {
  font-size: 64rpx;
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: block;
}

.avatar-reset {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 微信授权按钮 */
.wx-avatar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 80rpx;
  background: #F0F7FF;
  border: 2rpx solid #B4D0FF;
  border-radius: 40rpx;
  padding: 0 24rpx;
  margin: 0;
}
.wx-avatar-btn::after {
  border: none;
}
.wx-avatar-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}
.wx-avatar-text {
  font-size: 26rpx;
  color: #5B8FF9;
  font-weight: 500;
}

/* 昵称行 */
.nickname-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0 8rpx;
}

.nickname-label {
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.nickname-input {
  flex: 1;
  height: 64rpx;
  font-size: 30rpx;
  color: #333;
  text-align: right;
}

/* 协议行 */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  padding: 16rpx 0;
  margin: 0 24rpx;
}

.agreement-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  font-size: 20rpx;
  color: #fff;
  transition: all 0.2s;
}

.agreement-check.checked {
  background: #07C160;
  border-color: #07C160;
}

.agreement-text {
  font-size: 24rpx;
  color: #999;
}

.agreement-link {
  font-size: 24rpx;
  color: #5B8FF9;
}

/* 提交按钮 */
.submit-btn {
  margin: 24rpx 24rpx 0;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #5B8FF9 0%, #7B68EE 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #ccc;
  color: #fff;
}
