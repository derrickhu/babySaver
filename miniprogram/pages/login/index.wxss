/* 登录注册页样式 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #5B8FF9 0%, #E8F0FE 50%, #F5F7FA 100%);
  padding-bottom: 60rpx;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 60rpx;
}

.logo-wrapper {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(91, 143, 249, 0.3);
  margin-bottom: 24rpx;
}

.logo-icon {
  font-size: 80rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.login-form {
  margin: 0 32rpx;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 36rpx;
  text-align: center;
}

/* ===== 微信设置页风格单元格 ===== */
.cell-group {
  margin-bottom: 32rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ECECEC;
}

.cell:last-child {
  border-bottom: none;
}

/* button 作为 cell 时，重置全部默认样式 */
.cell-btn {
  width: 100%;
  background: none;
  border: none;
  border-radius: 0;
  margin: 0;
  padding: 16rpx 0;
  font-size: inherit;
  font-weight: normal;
  color: inherit;
  text-align: left;
  line-height: inherit;
  box-sizing: border-box;
  overflow: visible;
}

.cell-btn::after {
  display: none;
}

.cell-label {
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
}

.cell-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cell-arrow {
  font-size: 36rpx;
  color: #C0C0C0;
}

/* 头像（固定方形容器 + 圆裁剪） */
.cell-avatar-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #F5F5F5;
  flex-shrink: 0;
}

.cell-avatar {
  width: 72rpx;
  height: 72rpx;
  display: block;
}

.cell-avatar-holder {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

/* 昵称输入 */
.cell-input {
  flex: 1;
  height: 64rpx;
  font-size: 30rpx;
  color: #333;
  text-align: right;
  background: transparent;
  padding: 0;
}

/* ===== 表单区域 ===== */
.form-item {
  margin-bottom: 36rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 角色选择 */
.role-selector {
  display: flex;
  gap: 24rpx;
}

.role-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  transition: all 0.3s;
}

.role-option.active {
  border-color: var(--primary);
  background: var(--primary-light);
}

.role-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.role-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.role-desc {
  font-size: 22rpx;
  color: var(--text-hint);
}

.role-option.active .role-name {
  color: var(--primary);
}

/* 家长身份选择器 */
.parent-title-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.title-option {
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--border);
  background: var(--bg-page);
  transition: all 0.3s;
}

.title-option.active {
  border-color: var(--primary);
  background: var(--primary-light);
}

.title-option.active .title-text {
  color: var(--primary);
  font-weight: 600;
}

.title-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.register-btn {
  margin-top: 48rpx;
}
