<!-- 登录注册页 -->
<view class="login-page">
  <!-- ===== Step 1：欢迎屏 ===== -->
  <view class="welcome" wx:if="{{step === 1}}">
    <view class="welcome-top">
      <view class="logo-box">
        <text class="logo-icon">🐷</text>
      </view>
      <text class="app-name">小孩存钱宝</text>
      <text class="app-slogan">培养孩子的理财好习惯</text>
    </view>

    <view class="welcome-bottom">
      <button class="wx-login-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <text class="wx-login-text">微信一键登录</text>
      </button>
      <view class="agreement-row" bindtap="onToggleAgreement">
        <view class="agreement-check {{agreed ? 'checked' : ''}}">
          <text wx:if="{{agreed}}">✓</text>
        </view>
        <text class="agreement-text">阅读并同意</text>
        <text class="agreement-link" catchtap="onViewAgreement">《用户协议》</text>
        <text class="agreement-text">和</text>
        <text class="agreement-link" catchtap="onViewPrivacy">《隐私政策》</text>
      </view>
    </view>
  </view>

  <!-- ===== Step 2：完善资料 ===== -->
  <view class="profile-setup" wx:elif="{{step === 2}}">
    <!-- 顶部返回 -->
    <view class="setup-nav">
      <text class="setup-back" bindtap="onBackToWelcome">‹ 返回</text>
    </view>

    <text class="setup-title">完善资料</text>
    <text class="setup-subtitle">还差一步，即可开始使用</text>

    <!-- 头像 + 昵称 -->
    <view class="setup-card card">
      <button class="avatar-row" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="avatar-box">
          <image class="avatar-img" src="{{avatarUrl}}" wx:if="{{avatarUrl}}" mode="aspectFill"></image>
          <text class="avatar-placeholder" wx:else>👤</text>
        </view>
        <text class="avatar-change">点击更换头像</text>
      </button>

      <view class="nickname-row">
        <text class="nickname-label">昵称</text>
        <input
          class="nickname-input"
          type="nickname"
          placeholder="请输入昵称"
          value="{{nickName}}"
          bindinput="onNickNameInput"
          bindblur="onNickNameBlur"
          focus="{{focusNickname}}"
          maxlength="20"
        />
      </view>
    </view>

    <!-- 角色选择 -->
    <view class="setup-card card">
      <text class="card-label">选择身份</text>
      <view class="role-picker">
        <view
          class="role-card {{role === 'parent' ? 'active' : ''}}"
          data-role="parent"
          bindtap="onSelectRole"
        >
          <text class="role-emoji">👨‍👩‍👧</text>
          <text class="role-name">我是家长</text>
          <text class="role-desc">管理存款和审批</text>
        </view>
        <view
          class="role-card {{role === 'child' ? 'active' : ''}}"
          data-role="child"
          bindtap="onSelectRole"
        >
          <text class="role-emoji">🧒</text>
          <text class="role-name">我是小孩</text>
          <text class="role-desc">查看存款和取现</text>
        </view>
      </view>
    </view>

    <!-- 家长身份标识 -->
    <view class="setup-card card" wx:if="{{role === 'parent'}}">
      <text class="card-label">我是孩子的</text>
      <view class="title-picker">
        <view
          class="title-chip {{parentTitle === item ? 'active' : ''}}"
          wx:for="{{parentTitleOptions}}"
          wx:key="*this"
          data-title="{{item}}"
          bindtap="onSelectParentTitle"
        >{{item}}</view>
      </view>
    </view>

    <!-- 提交按钮 -->
    <button class="submit-btn" bindtap="onRegister" disabled="{{loading}}">
      {{loading ? '注册中...' : '开始使用'}}
    </button>
  </view>
</view>
