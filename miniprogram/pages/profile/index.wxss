/* 个人中心页样式 */
.profile-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 用户卡片 */
.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 40rpx;
  background: linear-gradient(180deg, #5B8FF9 0%, #E8F0FE 100%);
}

.user-avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(91, 143, 249, 0.25);
  margin-bottom: 20rpx;
}

.user-avatar-emoji {
  font-size: 72rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.user-role-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.user-role {
  /* 继承 tag 样式 */
}

.verified-badge, .unverified-badge {
  font-size: 22rpx;
}

.user-stats {
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 48rpx;
  border-radius: 16rpx;
}

.stats-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
  text-align: center;
}

.stats-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  text-align: center;
}

/* 菜单 */
.menu-section {
  margin-top: -20rpx;
  position: relative;
}

.menu-card {
  margin: 16rpx 24rpx;
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.menu-desc {
  font-size: 26rpx;
  color: var(--text-hint);
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
}

.menu-badge {
  background: var(--danger);
  color: #fff;
  font-size: 22rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 36rpx;
  padding: 0 8rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.title-picker-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.title-picker-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 36rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--border);
  background: var(--bg-page);
}

.title-picker-item.active {
  border-color: var(--primary);
  background: var(--primary-light);
}

.title-picker-text {
  font-size: 30rpx;
  color: var(--text-primary);
}

.title-picker-item.active .title-picker-text {
  color: var(--primary);
  font-weight: 600;
}

.title-picker-check {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 700;
}

.modal-cancel {
  text-align: center;
  font-size: 30rpx;
  color: var(--text-hint);
  padding: 20rpx;
}

/* 用户头像图片 */
.user-avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

/* 利率设置弹窗 */
.rate-tip {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 32rpx;
}
.rate-input-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  margin-bottom: 32rpx;
}
.rate-input {
  width: 200rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  border-bottom: 4rpx solid #4a7cf7;
  padding-bottom: 12rpx;
}
.rate-suffix {
  font-size: 36rpx;
  color: #999;
  margin-left: 12rpx;
}
.rate-actions {
  display: flex;
  gap: 24rpx;
}
.rate-cancel {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  color: #999;
  background: #f5f5f5;
  border-radius: 48rpx;
}
.rate-confirm {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #4a7cf7, #6c5ce7);
  border-radius: 48rpx;
  font-weight: 600;
}
