/* 个人中心页样式 */
.profile-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 用户卡片 */
.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 40rpx;
  background: linear-gradient(180deg, #5B8FF9 0%, #E8F0FE 100%);
}

.user-avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(91, 143, 249, 0.25);
  margin-bottom: 20rpx;
}

.user-avatar-emoji {
  font-size: 72rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.user-role {
  margin-bottom: 20rpx;
}

.user-stats {
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 48rpx;
  border-radius: 16rpx;
}

.stats-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
  text-align: center;
}

.stats-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  text-align: center;
}

/* 菜单 */
.menu-section {
  margin-top: -20rpx;
  position: relative;
}

.menu-card {
  margin: 16rpx 24rpx;
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.menu-desc {
  font-size: 26rpx;
  color: var(--text-hint);
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
}

.menu-badge {
  background: var(--danger);
  color: #fff;
  font-size: 22rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 36rpx;
  padding: 0 8rpx;
}
