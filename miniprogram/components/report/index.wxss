.refresh {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  color: #8c8276;
  font-size: 22rpx;
}

.refresh-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #1f4b99;
  animation: pulse 0.9s ease-in-out infinite;
}

.banner, .state.error {
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fde8ec;
  color: #e11d48;
  font-size: 24rpx;
  line-height: 1.5;
}

.state {
  padding: 48rpx 12rpx;
  text-align: center;
  color: #8c8276;
}

.card, .skel-card {
  background: #fffdf8;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 10rpx 28rpx rgba(48, 36, 18, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #241e18;
  margin-bottom: 16rpx;
}

.notice {
  color: #8c8276;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.kpis {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx 8rpx;
}

.kpi {
  width: 50%;
  box-sizing: border-box;
  padding: 12rpx 8rpx 16rpx;
}

.kpi-label {
  color: #8c8276;
  font-size: 22rpx;
  line-height: 1.35;
}

.kpi-value {
  margin-top: 4rpx;
  font-family: "DIN Alternate", "Avenir Next Condensed", "PingFang SC", sans-serif;
  font-size: 40rpx;
  font-weight: 700;
  color: #241e18;
  letter-spacing: -0.5rpx;
}

.kpi-sub {
  margin-top: 4rpx;
  color: #8c8276;
  font-size: 20rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.bar-label {
  width: 148rpx;
  color: #8c8276;
  font-size: 22rpx;
  line-height: 1.3;
  flex: none;
}

.bar-track {
  flex: 1;
  height: 12rpx;
  background: #efeae2;
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #1f4b99;
  border-radius: 999rpx;
}

.bar-text {
  width: 120rpx;
  text-align: right;
  font-family: "DIN Alternate", "Avenir Next Condensed", "PingFang SC", sans-serif;
  font-size: 22rpx;
  color: #241e18;
  flex: none;
}

.bar-wide {
  margin-top: 18rpx;
}

.bar-wide-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.bar-wide-name {
  flex: 1;
  color: #241e18;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 650;
}

.bar-wide-text {
  flex: none;
  font-family: "DIN Alternate", "Avenir Next Condensed", "PingFang SC", sans-serif;
  font-size: 26rpx;
  color: #241e18;
}

.bar-wide .bar-track {
  width: 100%;
  margin-top: 8rpx;
}

.sheet-block {
  margin-top: 8rpx;
}

.sheet-hint {
  margin-bottom: 8rpx;
  color: #8c8276;
  font-size: 22rpx;
}

.sheet-scroll {
  width: 100%;
  margin-left: -4rpx;
}

.sheet-row {
  display: flex;
  align-items: stretch;
}

.sheet-cell {
  box-sizing: border-box;
  flex: none;
  height: 76rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #efeae2;
  color: #241e18;
  font-size: 24rpx;
  font-family: "DIN Alternate", "Avenir Next Condensed", "PingFang SC", sans-serif;
  white-space: nowrap;
}

.sheet-cell.pin {
  position: sticky;
  left: 0;
  z-index: 2;
  background: #fffdf8;
  font-weight: 700;
  box-shadow: 8rpx 0 12rpx rgba(48, 36, 18, 0.05);
}

.sheet-row.head .sheet-cell {
  height: 64rpx;
  color: #8c8276;
  font-size: 22rpx;
  font-weight: 650;
  font-family: "PingFang SC", sans-serif;
}

.sheet-row.live {
  background: #eef3fb;
}

.sheet-row.live .sheet-cell.pin,
.sheet-row.open .sheet-cell.pin {
  background: #eef3fb;
}

.sheet-row.open {
  background: #f4efe6;
}

.sheet-cell.muted { color: #8c8276; }
.sheet-cell.up { color: #15803d; }
.sheet-cell.live { color: #1f4b99; }

.sheet-tag {
  margin-left: 6rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #e7eef8;
  color: #1f4b99;
  font-size: 18rpx;
  line-height: 30rpx;
  font-weight: 650;
  font-family: "PingFang SC", sans-serif;
}

.sheet-detail {
  position: sticky;
  left: 0;
  width: 654rpx;
  box-sizing: border-box;
  padding: 10rpx 12rpx 16rpx;
  background: #f7f1e6;
  color: #6f675e;
  font-size: 22rpx;
  line-height: 1.45;
}

.table-scroll {
  width: 100%;
  margin-top: 8rpx;
}

.table {
  display: table;
  min-width: 100%;
}

.tr { display: table-row; }

.td {
  display: table-cell;
  padding: 12rpx 18rpx 12rpx 0;
  font-size: 22rpx;
  white-space: nowrap;
  border-bottom: 1rpx solid #efeae2;
  color: #241e18;
}

.th .td {
  color: #8c8276;
  font-weight: 650;
  border-bottom-color: #e4d9c8;
}

.line {
  font-size: 26rpx;
  line-height: 1.55;
  padding: 6rpx 0;
  color: #241e18;
}

.mini {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #efeae2;
}

.mini-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mini-title { font-weight: 700; }

.mini-extra {
  color: #e11d48;
  font-size: 24rpx;
  padding: 6rpx 8rpx;
}

.mini-meta, .mini-line {
  margin-top: 6rpx;
  color: #6f675e;
  font-size: 24rpx;
  line-height: 1.5;
}

.skel-line, .skel-box {
  background: linear-gradient(90deg, #efeae2 25%, #f7f1e6 37%, #efeae2 63%);
  background-size: 400% 100%;
  animation: shimmer 1.2s ease infinite;
  border-radius: 10rpx;
}

.skel-line {
  height: 28rpx;
  margin-top: 16rpx;
}

.skel-line.lg {
  width: 42%;
  height: 34rpx;
  margin-top: 0;
}

.skel-line.short { width: 68%; }

.skel-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.skel-box {
  flex: 1;
  height: 92rpx;
}

@keyframes pulse {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
