.columns {
  display: block;
  width: 100%;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.chip {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f4efe6;
  color: #241e18;
}

.chip.on {
  background: #1f4b99;
  color: #fffdf8;
}

.chip-k {
  font-size: 22rpx;
  line-height: 1.3;
}

.chip-v {
  font-family: "DIN Alternate", "Avenir Next Condensed", "PingFang SC", sans-serif;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stage {
  display: flex;
  width: 100%;
}

.axis {
  width: 44px;
  height: 220px;
  flex: none;
}

.plot-box {
  flex: 1;
  min-width: 0;
  height: 220px;
}

.plot {
  width: 100%;
  height: 220px;
  display: block;
}

.hint {
  margin-top: 6rpx;
  color: #8c8276;
  font-size: 22rpx;
}

.readout {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #f4efe6;
  color: #241e18;
  font-size: 24rpx;
  line-height: 1.4;
}
